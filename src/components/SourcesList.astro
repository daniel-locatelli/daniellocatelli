---
/**
 * Grid of pages that use an entity's images (see lib/entity-usage.ts). Each
 * card shows the first entity image the page uses, its title and summary.
 */
import { Image } from "astro:assets";
import type { EntityUse } from "@/lib/entity-usage";

interface Props {
  uses: EntityUse[];
  deckLabel: string;
}

const { uses, deckLabel } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/content/entities/**/*.{jpeg,jpg,png,webp,avif,gif}",
);
const cards = await Promise.all(
  uses.map(async (use) => {
    const loader = images[use.images[0]];
    return { ...use, image: loader ? (await loader()).default : undefined };
  }),
);
---

<ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {
    cards.map((card) => (
      <li class="group overflow-hidden rounded-2xl bg-zinc-900 has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-green-400">
        <a href={card.href} class="flex h-full flex-col focus-visible:outline-none" data-astro-prefetch>
          {card.image && (
            <div class="aspect-4/3 overflow-hidden bg-zinc-800">
              <Image
                src={card.image}
                alt=""
                widths={[400, 800]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-lg font-bold text-white transition-colors group-hover:text-green-400">{card.title}</h2>
            {card.deckOnly && <p class="mt-1 text-xs tracking-wide text-zinc-500 uppercase">{deckLabel}</p>}
            {card.description && <p class="mt-2 line-clamp-2 text-sm text-zinc-300">{card.description}</p>}
          </div>
        </a>
      </li>
    ))
  }
</ul>
