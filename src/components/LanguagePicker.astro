---
import { SUPPORTED_LOCALES, type SupportedLocale } from "@/config/site";

interface Props {
  currentLocale: SupportedLocale;
  slug: string | undefined;
  class?: string;
}

const { currentLocale, slug, class: className } = Astro.props;

const getLocalePath = (locale: SupportedLocale) => {
  const base = locale === "en" ? "" : `/${locale}`;
  const slugPath = slug ? `/${slug}` : "";
  const path = `${base}${slugPath}`;
  return path === "" ? "/" : path;
};

const labels: Record<SupportedLocale, string> = {
  en: "English",
  pt: "Português",
  de: "Deutsch",
};
---

<div
  class={`relative group/picker w-full sm:w-auto  ${className}`}
  id="language-picker"
>
  <button
    type="button"
    class="flex w-full items-center justify-center gap-1.5 border-b border-white py-6 text-xl transition-colors sm:w-auto sm:border-none sm:py-0 sm:text-sm"
    aria-haspopup="true"
    id="language-picker-button"
  >
    <svg
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      class="inline size-5 sm:size-4"
    >
      <rect
        width="15"
        height="15"
        x="0.5"
        y="0.5"
        stroke="currentColor"
        rx="7.5"></rect>
      <path
        stroke="currentColor"
        d="M1 8h14m-4.5 0c0 2.165-.33 4.103-.847 5.481-.259.691-.556 1.216-.86 1.559s-.573.46-.793.46-.49-.117-.794-.46-.6-.868-.86-1.559C5.83 12.103 5.5 10.165 5.5 8s.33-4.103.847-5.481c.259-.691.555-1.216.86-1.559C7.51.617 7.78.5 8 .5s.49.117.794.46c.303.343.6.868.86 1.559.516 1.378.846 3.316.846 5.481Z"
      ></path>
    </svg>
    <span class="sr-only">Change language, current: </span>
    <span class="font-medium tracking-wider uppercase">{currentLocale}</span>
    <svg
      class="hidden size-3 transition-transform sm:block"
      id="language-picker-chevron"
      aria-hidden="true"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    id="language-picker-menu"
    class="animate-in fade-in slide-in-from-top-2 z-50 hidden flex-col duration-200 sm:absolute sm:top-full sm:right-0 sm:mt-1 sm:min-w-[140px] sm:rounded-xl sm:border sm:border-zinc-800 sm:bg-zinc-900/95 sm:py-2 sm:shadow-2xl sm:backdrop-blur-md"
  >
    {
      SUPPORTED_LOCALES.map((locale) => (
        <a
          href={getLocalePath(locale)}
          class={`group/item flex items-center justify-center border-b border-zinc-400 py-6 text-xl transition-colors hover:bg-white/5 sm:justify-between sm:border-none sm:px-4 sm:py-2.5 sm:text-sm ${locale === currentLocale ? "text-green-400" : "text-zinc-300"}`}
        >
          <span>{labels[locale]}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  /* Bridge to help keep menu open when moving from button to menu */
  @media (min-width: 640px) {
    #language-picker-menu::before {
      content: "";
      position: absolute;
      top: -12px;
      left: 0;
      right: 0;
      height: 12px;
    }
  }
</style>

<script>
  function setupLanguagePicker() {
    const picker = document.getElementById("language-picker");
    const btn = document.getElementById("language-picker-button");
    const menu = document.getElementById("language-picker-menu");
    const chevron = document.getElementById("language-picker-chevron");

    if (!picker || !btn || !menu) return;

    let hideTimeout: number;

    const showMenu = () => {
      clearTimeout(hideTimeout);
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      if (chevron) chevron.classList.add("rotate-180");
    };

    const hideMenu = () => {
      // 300ms delay gives the user time to move the mouse back or across gaps
      hideTimeout = window.setTimeout(() => {
        menu.classList.add("hidden");
        menu.classList.remove("flex");
        if (chevron) chevron.classList.remove("rotate-180");
      }, 300);
    };

    // Desktop/Hover behavior
    picker.addEventListener("mouseenter", () => {
      if (window.innerWidth >= 640) {
        showMenu();
      }
    });

    picker.addEventListener("mouseleave", () => {
      if (window.innerWidth >= 640) {
        hideMenu();
      }
    });

    // Mobile behavior
    btn.addEventListener("click", (e) => {
      if (window.innerWidth < 640) {
        e.preventDefault();
        const isHidden = menu.classList.contains("hidden");
        if (isHidden) {
          menu.classList.remove("hidden");
          menu.classList.add("flex");
        } else {
          menu.classList.add("hidden");
          menu.classList.remove("flex");
        }
      }
    });

    // Close menu when clicking outside (on mobile)
    document.addEventListener("click", (e) => {
      if (window.innerWidth < 640 && !picker.contains(e.target as Node)) {
        menu.classList.add("hidden");
        menu.classList.remove("flex");
      }
    });
  }

  // Setup on initial load
  setupLanguagePicker();

  // Setup on view transitions
  document.addEventListener("astro:after-swap", setupLanguagePicker);
</script>
