---
/**
 * Renders child images side-by-side on desktop, stacked on mobile.
 * Extracts alt text from each image and displays it as a visible caption.
 * Usage in MDX:
 *   import ImageRow from '@/components/ImageRow.astro'
 *   <ImageRow>
 *     ![Alt text 1](./path1.jpg)
 *     ![Alt text 2](./path2.jpg)
 *   </ImageRow>
 */
---

<div class="image-row not-prose my-6 flex flex-col gap-4 sm:flex-row [&>*]:min-w-0 sm:[&>*]:flex-1">
  <slot />
</div>

<script>
  function wrapImageRowImages() {
    document.querySelectorAll(".image-row").forEach((row) => {
      row.querySelectorAll("img").forEach((img) => {
        if (img.closest("figure")) return;
        const alt = img.getAttribute("alt");
        if (!alt) return;

        const figure = document.createElement("figure");
        const caption = document.createElement("figcaption");
        caption.textContent = alt;

        img.parentNode!.insertBefore(figure, img);
        figure.appendChild(img);
        figure.appendChild(caption);
      });
    });
  }

  document.addEventListener("astro:page-load", wrapImageRowImages);
</script>
