---
import type { SiteMeta } from "@/types";
import { siteConfig, SUPPORTED_LOCALES } from "@/config/site";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/fonts.css";
import { getLocale } from "src/lib/routes-helpers";

const locale = getLocale(Astro.params, Astro.url)

type Props = SiteMeta;

const { articleDate, description, coverImage, coverAlt, title, viewTransition, alternateLocales } =
  Astro.props;

// hreflang alternates. Strip the current locale prefix to get the bare path,
// then re-prefix it for each locale this page exists in. x-default points at
// the default locale (which is served without a prefix).
const localesForPage = alternateLocales ?? SUPPORTED_LOCALES;
const barePath =
  locale === siteConfig.defaultLocale
    ? Astro.url.pathname
    : Astro.url.pathname.replace(new RegExp(`^/${locale}(?=/|$)`), "") || "/";
const hreflangs = localesForPage.map((loc) => {
  const prefix = loc === siteConfig.defaultLocale ? "" : `/${loc}`;
  const path = `${prefix}${barePath}` || "/";
  return { hreflang: loc, href: new URL(path, Astro.site).href };
});
const xDefaultHref = new URL(barePath || "/", Astro.site).href;

// I removed the separator and the name from the title to make it cleaner when using it for references in Zotero etc.
const siteTitle =
  title === siteConfig.title
    ? siteConfig.title
    : title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
  coverImage || siteConfig.defaultSocialImage,
  Astro.site,
).href;
---

<meta charset="utf-8" />
<meta
  content="width=device-width, initial-scale=1.0, shrink-to-fit=no"
  name="viewport"
/>
<meta content="IE=edge" http-equiv="X-UA-Compatible" />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<meta name="apple-mobile-web-app-title" content="D Locatelli" />
<link rel="manifest" href="/manifest.webmanifest?v=2" crossorigin="use-credentials" />
<link href={canonicalURL} rel="canonical" />

{/* hreflang alternates */}
{
  hreflangs.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Theme Colour */}
<meta content="#000000" name="theme-color" />
<meta content="#000000" name="msapplication-TileColor" />

{/* Open Graph / Facebook */}
<meta property="og:type" content={articleDate ? "article" : "website"} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="article:author:first_name" content={siteConfig.authorFirstName} />
<meta property="article:author:last_name" content={siteConfig.authorLastName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={locale ? locale : siteConfig.defaultLocale} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="675" />
<meta property="og:image:alt" content={coverAlt} />
{
  articleDate && (
    <>
      <meta content={siteConfig.author} property="article:author" />
      <meta content={articleDate} property="article:published_time" />
    </>
  )
}

{/* Twitter */}
<meta content="summary_large_image" name="twitter:card" />
<meta content={canonicalURL} name="twitter:url" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImageURL} name="twitter:image" />

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

<meta content={Astro.generator} name="generator" />

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteConfig.author,
  "givenName": siteConfig.authorFirstName,
  "familyName": siteConfig.authorLastName,
  "url": Astro.site,
})}>
</script>

{viewTransition && <ClientRouter />}