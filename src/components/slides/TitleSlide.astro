---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  author?: string;
  institution?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imagePosition?: string;
  darkText?: boolean;
  fit?: "cover" | "contain";
  overlay?: string;
}

const {
  title,
  subtitle,
  author,
  institution,
  image,
  imageAlt = "",
  imagePosition = "center",
  darkText = false,
  fit = "cover",
  overlay,
} = Astro.props;

const fitClass = fit === "contain" ? "object-contain" : "object-cover";

const textColor = darkText ? "text-zinc-950" : "text-white";

const isStringImage = typeof image === "string";

// When an explicit `overlay` is set, it replaces the default gradient so the
// caller controls darkening fully. Format mirrors the Slide overlay field:
// "<black|white>/<0-100>". Mismatched values fall through harmlessly (no
// overlay rendered) since the YAML validator already gates the format.
let overlayStyle: string | undefined;
if (overlay) {
  const m = overlay.match(/^(black|white)\/(\d+)$/);
  if (m) {
    const rgb = m[1] === "black" ? "0, 0, 0" : "255, 255, 255";
    const alpha = parseInt(m[2], 10) / 100;
    overlayStyle = `background-color: rgba(${rgb}, ${alpha});`;
  }
}
---

<section
  data-slide
  class="slide relative h-svh w-full overflow-hidden bg-black text-zinc-100"
>
  {
    image &&
      (isStringImage ? (
        <img
          src={image as string}
          alt={imageAlt}
          loading="eager"
          decoding="async"
          class={`absolute inset-0 h-full w-full ${fitClass}`}
          style={`object-position: ${imagePosition};`}
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={imageAlt}
          loading="eager"
          decoding="async"
          class={`absolute inset-0 h-full w-full ${fitClass}`}
          style={`object-position: ${imagePosition};`}
        />
      ))
  }

  {image && !overlayStyle && <div class="absolute inset-0 z-[5] bg-gradient-to-t from-black/70 via-black/50 to-transparent" />}
  {overlayStyle && <div class="absolute inset-0 z-[5]" style={overlayStyle} />}

  <div
    class={`absolute inset-0 z-10 flex flex-col items-center justify-center px-8 text-center ${textColor}`}
  >
    <h1
      class="max-w-5xl text-3xl leading-tight font-bold tracking-wide whitespace-pre-line uppercase text-shadow-xs sm:text-5xl lg:text-6xl"
      style="font-family: 'Montserrat', sans-serif;"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p
          class="mt-4 max-w-4xl text-base leading-relaxed font-light tracking-wide whitespace-pre-line italic text-pretty opacity-80 text-shadow-xs sm:text-xl lg:text-2xl"
          style="font-family: 'Poppins', sans-serif;"
        >
          {subtitle}
        </p>
      )
    }
    {
      (author || institution) && (
        <div class="mt-16 flex flex-col gap-1">
          {author && (
            <p
              class="text-base font-bold tracking-wider uppercase text-shadow-xs sm:text-lg lg:text-xl"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {author}
            </p>
          )}
          {institution && (
            <p
              class="text-sm tracking-wider uppercase opacity-70 text-shadow-xs sm:text-base lg:text-lg"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {institution}
            </p>
          )}
        </div>
      )
    }
  </div>
  <slot />
</section>
