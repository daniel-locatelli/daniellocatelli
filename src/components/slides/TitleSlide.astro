---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  author?: string;
  institution?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imagePosition?: string;
  darkText?: boolean;
}

const {
  title,
  subtitle,
  author,
  institution,
  image,
  imageAlt = "",
  imagePosition = "center",
  darkText = false,
} = Astro.props;

const textColor = darkText ? "text-zinc-950" : "text-white";

const isStringImage = typeof image === "string";
---

<section
  data-slide
  class="slide relative h-svh w-full overflow-hidden bg-zinc-950 text-zinc-100"
>
  {
    image &&
      (isStringImage ? (
        <img
          src={image as string}
          alt={imageAlt}
          loading="eager"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${imagePosition};`}
        />
      ) : (
        <Image
          src={image as ImageMetadata}
          alt={imageAlt}
          loading="eager"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${imagePosition};`}
        />
      ))
  }

  {image && <div class="absolute inset-0 z-[5] bg-gradient-to-t from-black via-black/80 to-transparent" />}

  <div
    class={`absolute inset-0 z-10 flex flex-col items-center justify-center px-8 text-center ${textColor}`}
  >
    <h1
      class="max-w-5xl text-3xl leading-tight font-bold tracking-wide uppercase sm:text-5xl lg:text-6xl"
      style="font-family: 'Montserrat', sans-serif;"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p
          class="mt-4 max-w-4xl text-base leading-relaxed font-light tracking-wide italic opacity-80 sm:text-xl lg:text-2xl"
          style="font-family: 'Poppins', sans-serif;"
        >
          {subtitle}
        </p>
      )
    }
    {
      (author || institution) && (
        <div class="mt-16 flex flex-col gap-1">
          {author && (
            <p
              class="text-base font-bold tracking-wider uppercase sm:text-lg lg:text-xl"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {author}
            </p>
          )}
          {institution && (
            <p
              class="text-sm tracking-wider uppercase opacity-70 sm:text-base lg:text-lg"
              style="font-family: 'Montserrat', sans-serif;"
            >
              {institution}
            </p>
          )}
        </div>
      )
    }
  </div>
</section>
