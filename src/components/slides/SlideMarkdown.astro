---
import { renderSlideMarkdown } from "@/lib/slide-markdown";

interface Props {
  text: string;
  // Vertical alignment within the slide. Default 'center' matches the
  // current TextSlide hero behavior.
  align?: "center" | "top" | "bottom";
  darkText?: boolean;
}

const { text, align = "center", darkText = false } = Astro.props;

const html = renderSlideMarkdown(text);

const justify =
  align === "top" ? "justify-start pt-16" :
  align === "bottom" ? "justify-end pb-16" :
  "justify-center";

const textColor = darkText ? "text-zinc-950" : "text-white";
---

<div
  class:list={[
    "absolute inset-0 z-10 flex flex-col items-center px-8 text-center",
    justify,
    textColor,
    "slide-md",
  ]}
>
  <div class="max-w-5xl" set:html={html} />
</div>

<style is:global>
  /* Project-consistent typography for slide markdown. Size tiers are
     intentionally comparable to TextSlide (h1 ≈ lg hero, p ≈ body) so
     migrated slides retain visual continuity. Implementation uses clamp()
     rather than Tailwind step classes because set:html precludes utility
     classes on generated elements. Authors get heading hierarchy via
     markdown structure; visual scale is never authored. */
  .slide-md h1 {
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-wrap: balance;
    font-size: clamp(1.875rem, 5.25vw, 4.5rem);
    margin: 0 0 1.5rem 0;
  }

  .slide-md h2 {
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
    font-size: clamp(1.3125rem, 3.375vw, 2.625rem);
    margin: 0 0 1rem 0;
  }

  .slide-md h3 {
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
    font-size: clamp(0.9375rem, 2.25vw, 1.6875rem);
    margin: 0 0 0.75rem 0;
  }

  .slide-md p {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    line-height: 1.5;
    text-wrap: pretty;
    font-size: clamp(0.9375rem, 1.65vw, 1.375rem);
    margin: 0 0 1rem 0;
  }

  /* Blockquotes in slide markdown are full-slide pull quotes, not inline
     body quotes. The wrapper already centers content, so no border or
     left-indent; size matches the headline tier so quote text reads as a
     primary visual element. */
  .slide-md blockquote {
    font-family: "Poppins", sans-serif;
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    margin: 0 0 1.5rem 0;
    font-size: clamp(1.5rem, 3.8vw, 3rem);
    max-width: none;
  }

  /* Pull-quote slides get a wider content column so a long quote wraps into
     a few wide lines instead of a tall, narrow pile. Scoped via :has() so
     title/heading slides keep the standard (narrower) measure. The 80rem cap
     keeps line length readable on ultrawide displays. */
  .slide-md > .max-w-5xl:has(blockquote) {
    max-width: 80rem;
  }

  /* Markdown wraps blockquote content in a <p>, which would otherwise be
     caught by the `.slide-md p` body rule (equal specificity) and render at
     body size. Force the inner paragraph to inherit the blockquote's
     pull-quote typography so the quote text actually takes the size above. */
  .slide-md blockquote p {
    font-size: inherit;
    font-weight: inherit;
    font-style: inherit;
    line-height: inherit;
    text-wrap: balance;
    margin: 0;
  }

  /* When an h2 directly follows a blockquote it is a quote attribution
     (e.g. the speaker's name), not a section header. Render it as a
     subordinate credit so the quote itself stays the hero: smaller, and
     lighter than the bold 700 used for standalone headers, which would
     otherwise out-weigh the light-300 quote even at a larger pixel size. */
  .slide-md blockquote + h2 {
    font-size: clamp(0.9375rem, 2vw, 1.625rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .slide-md ul,
  .slide-md ol {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    font-size: clamp(0.9375rem, 1.65vw, 1.375rem);
    line-height: 1.5;
    text-align: left;
    margin: 0 auto 1rem auto;
    max-width: 40em;
  }

  .slide-md :last-child {
    margin-bottom: 0;
  }
</style>
