---
import Credit, { type CreditLine } from "@/components/Credit.astro";

interface Props {
  title?: string;
  subtitle?: string;
  darkText?: boolean;
  copyright?: CreditLine | CreditLine[];
}

const { title, subtitle, darkText = false, copyright } = Astro.props;

const textColor = darkText ? "text-zinc-950" : "text-white";
---

{
  (title || subtitle) && (
    <div
      class={`absolute top-4 left-4 z-10 flex max-w-[60%] flex-col items-start text-left sm:top-6 sm:left-6 ${textColor} rounded bg-black/50 px-4 py-3 backdrop-blur-sm`}
    >
      {title && (
        <h2
          class="text-lg leading-tight font-bold tracking-wide whitespace-pre-line uppercase sm:text-2xl lg:text-3xl"
          style="font-family: 'Montserrat', sans-serif;"
        >
          {title}
        </h2>
      )}
      {subtitle && (
        <p
          class="mt-1 text-xs leading-tight font-normal tracking-wider whitespace-pre-line uppercase sm:text-sm lg:text-base"
          style="font-family: 'Montserrat', sans-serif;"
        >
          {subtitle}
        </p>
      )}
    </div>
  )
}

{copyright && <Credit credit={copyright} class="bottom-4 left-4 sm:bottom-6 sm:left-6" />}
