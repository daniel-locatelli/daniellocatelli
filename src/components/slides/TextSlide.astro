---
interface Props {
  text: string;
  subtext?: string;
  size?: "sm" | "md" | "lg" | "xl";
  case?: "upper" | "normal";
}

const { text, subtext, size = "lg", case: textCase = "normal" } = Astro.props;

const sizeClass =
  size === "xl"
    ? "text-5xl sm:text-7xl lg:text-8xl"
    : size === "md"
      ? "text-3xl sm:text-5xl lg:text-6xl"
      : size === "sm"
        ? "text-2xl sm:text-4xl lg:text-5xl"
        : "text-4xl sm:text-6xl lg:text-7xl";

const caseClass = textCase === "upper" ? "uppercase tracking-wide" : "";
const subtextCaseClass = textCase === "upper" ? "uppercase tracking-widest" : "";
---

<section
  data-slide
  class="slide relative flex h-svh w-full items-center justify-center bg-black px-8 text-center text-zinc-100 sm:px-16"
>
  <div class="max-w-5xl">
    <p
      class={`${sizeClass} leading-tight font-bold whitespace-pre-line text-balance ${caseClass}`}
      style="font-family: 'Montserrat', sans-serif;"
    >
      {text}
    </p>
    {
      subtext && (
        <p
          class={`mt-8 text-lg font-normal whitespace-pre-line opacity-75 sm:text-2xl ${subtextCaseClass}`}
          style="font-family: 'Montserrat', sans-serif;"
        >
          {subtext}
        </p>
      )
    }
  </div>
  <slot />
</section>
