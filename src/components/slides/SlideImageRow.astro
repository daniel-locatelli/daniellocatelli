---
import { Image } from "astro:assets";
import Credit, { type CreditLine } from "@/components/Credit.astro";
import SlideChrome from "./SlideChrome.astro";

interface ImageItem {
  src: ImageMetadata | string;
  alt?: string;
  copyright?: CreditLine | CreditLine[];
}

interface Props {
  title?: string;
  subtitle?: string;
  images: ImageItem[];
  darkText?: boolean;
  copyright?: CreditLine | CreditLine[];
  gap?: "none" | "sm" | "md" | "lg";
  fit?: "cover" | "contain";
}

const {
  title,
  subtitle,
  images,
  darkText = false,
  copyright,
  gap = "sm",
  fit = "contain",
} = Astro.props;

const fitClass = fit === "contain" ? "object-contain" : "object-cover";
const gapClass =
  gap === "none" ? "gap-0" : gap === "lg" ? "gap-6" : gap === "md" ? "gap-4" : "gap-1";

const gridColsClass =
  images.length >= 4
    ? "grid-cols-4"
    : images.length === 3
      ? "grid-cols-3"
      : "grid-cols-2";
---

<section
  data-slide
  class="slide relative h-svh w-full overflow-hidden bg-black text-zinc-100"
>
  {/* Wrapper divs establish a positioning context per cell so the
      absolutely-positioned <img> with inset-0 wins over the global
      `.slide img { height: auto }` rule in Slides.astro. */}
  <div class={`absolute inset-0 grid ${gridColsClass} ${gapClass} p-2`}>
    {
      images.map((img) => (
        <div class="relative h-full w-full overflow-hidden">
          {typeof img.src === "string" ? (
            <img
              src={img.src as string}
              alt={img.alt ?? ""}
              loading="eager"
              decoding="async"
              class={`absolute inset-0 h-full w-full ${fitClass}`}
            />
          ) : (
            <Image
              src={img.src as ImageMetadata}
              alt={img.alt ?? ""}
              loading="eager"
              decoding="async"
              class={`absolute inset-0 h-full w-full ${fitClass}`}
            />
          )}
          {img.copyright && <Credit credit={img.copyright} class="bottom-2 left-2" />}
        </div>
      ))
    }
  </div>

  <SlideChrome title={title} subtitle={subtitle} darkText={darkText} copyright={copyright} />

  <slot />
</section>
