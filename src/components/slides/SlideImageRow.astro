---
import { Image } from "astro:assets";
import Credit from "@/components/Credit.astro";

interface ImageItem {
  src: ImageMetadata | string;
  alt?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  images: ImageItem[];
  darkText?: boolean;
  copyright?: string | string[];
  gap?: "none" | "sm" | "md" | "lg";
  fit?: "cover" | "contain";
}

const {
  title,
  subtitle,
  images,
  darkText = false,
  copyright,
  gap = "sm",
  fit = "contain",
} = Astro.props;

const textColor = darkText ? "text-zinc-950" : "text-white";
const fitClass = fit === "contain" ? "object-contain" : "object-cover";
const gapClass =
  gap === "none" ? "gap-0" : gap === "lg" ? "gap-6" : gap === "md" ? "gap-4" : "gap-1";

const gridColsClass =
  images.length >= 4
    ? "grid-cols-4"
    : images.length === 3
      ? "grid-cols-3"
      : "grid-cols-2";
---

<section
  data-slide
  class="slide relative h-svh w-full overflow-hidden bg-black text-zinc-100"
>
  {/* Wrapper divs establish a positioning context per cell so the
      absolutely-positioned <img> with inset-0 wins over the global
      `.slide img { height: auto }` rule in Slides.astro. */}
  <div class={`absolute inset-0 grid ${gridColsClass} ${gapClass} p-2`}>
    {
      images.map((img) => (
        <div class="relative h-full w-full overflow-hidden">
          {typeof img.src === "string" ? (
            <img
              src={img.src as string}
              alt={img.alt ?? ""}
              loading="eager"
              decoding="async"
              class={`absolute inset-0 h-full w-full ${fitClass}`}
            />
          ) : (
            <Image
              src={img.src as ImageMetadata}
              alt={img.alt ?? ""}
              loading="eager"
              decoding="async"
              class={`absolute inset-0 h-full w-full ${fitClass}`}
            />
          )}
        </div>
      ))
    }
  </div>

  {
    (title || subtitle) && (
      <div
        class={`absolute top-4 left-4 z-10 flex max-w-[60%] flex-col items-start text-left sm:top-6 sm:left-6 ${textColor} rounded bg-black/50 px-4 py-3 backdrop-blur-sm`}
      >
        {title && (
          <h2
            class="text-lg leading-tight font-bold tracking-wide uppercase sm:text-2xl lg:text-3xl"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {title}
          </h2>
        )}
        {subtitle && (
          <p
            class="mt-2 text-sm leading-tight font-normal tracking-wider uppercase sm:text-base lg:text-lg"
            style="font-family: 'Montserrat', sans-serif;"
          >
            {subtitle}
          </p>
        )}
      </div>
    )
  }

  {copyright && <Credit credit={copyright} class="bottom-4 left-4 sm:bottom-6 sm:left-6" />}

  <slot />
</section>
