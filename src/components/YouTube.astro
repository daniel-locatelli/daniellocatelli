---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<figure class="my-6">
  <iframe
    class="aspect-video w-full rounded-lg"
    src={`https://www.youtube.com/embed/${id}`}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</figure>
