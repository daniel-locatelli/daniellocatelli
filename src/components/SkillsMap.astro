---
import AutoCad from "../assets/tech-stack/autocad.svg";
import Revit from "../assets/tech-stack/revit.svg";
import Civil3D from "../assets/tech-stack/civil3d.svg";
import Dynamo from "../assets/tech-stack/dynamo.svg";
import Grasshopper from "../assets/tech-stack/grasshopper3d.svg";
import Kangaroo from "../assets/tech-stack/kangaroo3d.svg";
import Weaverbird from "../assets/tech-stack/weaverbird.png";
import Galapagos from "../assets/tech-stack/galapagos.svg";
import Ladybug from "../assets/tech-stack/ladybug-tools.svg";
import Culebra from "../assets/tech-stack/culebra.svg";
import Karamba from "../assets/tech-stack/karamba3d.svg";
import Python from "../assets/tech-stack/python.svg";
import CSharp from "../assets/tech-stack/c-sharp.svg";
import HTML from "../assets/tech-stack/html-5.svg";
import CSS from "../assets/tech-stack/css.svg";
import TypescriptLogo from "../assets/tech-stack/typescript.svg";
import FlaskLogo from "../assets/tech-stack/flask.svg";
import TanStackStartLogo from "../assets/tech-stack/tanstack-start.png";
import AstroLogo from "../assets/tech-stack/astro.svg";
import ReactLogo from "../assets/tech-stack/react.svg";
import MongoDB from "../assets/tech-stack/mongo-db.svg";
import SQLite from "../assets/tech-stack/sqlite.svg";
import PostgreSQL from "../assets/tech-stack/postgresql.svg";
import SkillsMapItem from "@/components/SkillsMapItem.astro";
import { getLocale } from "src/lib/routes-helpers";
import { getI18n } from "src/i18n/utils";
import type { I18nMeta } from "src/i18n/meta/types";
import type { I18nHome } from "src/i18n/home/types";

const locale = getLocale(Astro.params, Astro.url);
const meta = await getI18n<I18nMeta>("meta", locale);
const home = await getI18n<I18nHome>("home", locale);
const newTabHint = `(${meta.openNewTab})`;
const tips = home.expertise.tools;
const localePrefix = locale === "en" ? "" : "/" + locale;
const shared = { newTabHint, localePrefix };
---

<div id="chart-container" class="w-full">
  <!-- CAD -->
  <div class="section">
    <div
      class="absolute top-0 left-5 z-10 flex h-7 -translate-y-3.5 items-center justify-center rounded-sm bg-zinc-800 px-2 pb-1 font-sans text-sm"
    >
      CAD & BIM
    </div>
    <!-- CAD Subsection -->
    <div
      class="grid w-full grid-cols-3 items-center justify-around gap-4 py-4 md:py-10"
    >
      <SkillsMapItem
        {...shared}
        id="autocad"
        href="https://www.autodesk.com/products/autocad/overview"
        src={AutoCad}
        alt="AutoCAD logo"
        label="AutoCAD"
        tip={tips.autocad}
      />
      <SkillsMapItem
        {...shared}
        id="civil3d"
        href="https://www.autodesk.com/products/civil-3d/overview"
        src={Civil3D}
        alt="Civil 3D logo"
        label="Civil 3D"
        tip={tips.civil3d}
      />
      <SkillsMapItem
        {...shared}
        id="revit"
        href="https://www.autodesk.com/products/revit/overview"
        src={Revit}
        alt="Revit logo"
        label="Revit"
        tip={tips.revit}
      />
    </div>
  </div>

  <!-- Computational Design Section -->
  <div class="section">
    <div
      class="absolute top-0 left-5 z-10 flex h-7 -translate-y-3.5 items-center justify-center rounded-sm bg-zinc-800 px-2 pb-1 font-sans text-sm"
    >
      Computational Design
    </div>
    <div class="flex flex-col items-center justify-around gap-12 py-4 md:py-10">
      <div class="flex w-full items-center justify-around">
        <SkillsMapItem
          {...shared}
          id="dynamo"
          href="https://dynamobim.org/"
          src={Dynamo}
          alt="Dynamo logo"
          label="Dynamo"
          tip={tips.dynamo}
        />
        <SkillsMapItem
          {...shared}
          id="grasshopper"
          href="https://en.wikipedia.org/wiki/Grasshopper_3D"
          src={Grasshopper}
          alt="Grasshopper logo"
          label="Grasshopper"
          tip={tips.grasshopper}
          logoBg="bg-[#579141]"
        />
      </div>
      <div
        class="relative w-full rounded-lg border border-dashed border-white p-4"
      >
        <div class="absolute -top-3 h-6 rounded bg-zinc-800 px-2 pt-1 text-xs">
          Add-ons
        </div>
        <div
          class="grid w-full grid-cols-3 items-center justify-around gap-4 py-4 md:flex"
        >
          <SkillsMapItem
            {...shared}
            id="kangaroo"
            href="https://www.food4rhino.com/en/app/kangaroo-physics"
            src={Kangaroo}
            alt="Kangaroo logo"
            label="Kangaroo"
            tip={tips.kangaroo}
          />
          <SkillsMapItem
            {...shared}
            id="galapagos"
            href="https://www.grasshopper3d.com/group/galapagos"
            src={Galapagos}
            alt="Galapagos logo"
            label="Galapagos"
            tip={tips.galapagos}
          />
          <SkillsMapItem
            {...shared}
            id="weaverbird"
            href="https://www.giuliopiacentino.com/weaverbird/"
            src={Weaverbird}
            alt="Weaverbird logo"
            label="Weaverbird"
            tip={tips.weaverbird}
          />
          <SkillsMapItem
            {...shared}
            id="ladybug"
            href="https://www.ladybug.tools/"
            src={Ladybug}
            alt="Ladybug Tools logo"
            label="Ladybug Tools"
            tip={tips.ladybug}
          />
          <SkillsMapItem
            {...shared}
            id="culebra"
            href="https://www.complicitmatter.com/culebra-net/"
            src={Culebra}
            alt="Culebra logo"
            label="Culebra"
            tip={tips.culebra}
          />
          <SkillsMapItem
            {...shared}
            id="karamba"
            href="https://karamba3d.com/"
            src={Karamba}
            alt="Karamba3D logo"
            label="Karamba3D"
            tip={tips.karamba}
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Programming Section -->
  <div class="section">
    <div
      class="absolute top-0 left-5 z-10 flex h-7 -translate-y-3.5 items-center justify-center rounded-sm bg-zinc-800 px-2 pb-1 font-sans text-sm"
    >
      Programming
    </div>
    <div class="flex flex-col items-center justify-around gap-12 py-4 md:py-10">
      <div
        class="relative w-full rounded-lg border border-dashed border-white p-4"
      >
        <div
          class="absolute -top-3 left-3 h-6 rounded bg-zinc-800 px-2 pt-1 text-xs"
        >
          Languages
        </div>
        <div class="flex flex-wrap items-center justify-around gap-8 py-4">
          <SkillsMapItem
            {...shared}
            id="python"
            href="https://www.python.org/"
            src={Python}
            alt="Python logo"
            label="Python"
            tip={tips.python}
          />
          <SkillsMapItem
            {...shared}
            id="csharp"
            href="https://dotnet.microsoft.com/en-us/languages/csharp"
            src={CSharp}
            alt="C# logo"
            label="C#"
            tip={tips.csharp}
          />
          <div
            class="relative flex w-full items-center justify-around rounded-xl border border-dashed border-white py-6 md:w-fit md:justify-between md:gap-8 md:px-8"
          >
            <div
              class="absolute -top-3 left-3 h-6 rounded bg-zinc-800 px-2 pt-1 text-xs"
            >
              Web development
            </div>
            <SkillsMapItem
              {...shared}
              id="html"
              href="https://html.spec.whatwg.org/multipage/"
              src={HTML}
              alt="HTML logo"
              label="HTML"
              tip={tips.html}
              logoBg=""
            />
            <SkillsMapItem
              {...shared}
              id="css"
              href="https://www.w3.org/Style/CSS/Overview.en.html"
              src={CSS}
              alt="CSS logo"
              label="CSS"
              tip={tips.css}
              logoBg=""
            />
            <SkillsMapItem
              {...shared}
              id="typescript"
              href="https://www.typescriptlang.org/"
              src={TypescriptLogo}
              alt="TypeScript logo"
              label="TypeScript"
              tip={tips.typescript}
              logoBg=""
            />
          </div>
        </div>
      </div>

      <div
        class="relative flex w-full items-center justify-around rounded-xl border border-dashed border-white py-6 md:px-8"
      >
        <div
          class="absolute -top-3 left-3 h-6 rounded bg-zinc-800 px-2 pt-1 text-xs"
        >
          Frameworks
        </div>
        <div
          class="grid w-full grid-cols-4 items-center justify-around py-4 md:py-10"
        >
          <SkillsMapItem
            {...shared}
            id="flask"
            href="https://palletsprojects.com/projects/flask/"
            src={FlaskLogo}
            alt="Flask logo"
            label="Flask"
            tip={tips.flask}
          />
          <SkillsMapItem
            {...shared}
            id="tanstack"
            href="https://tanstack.com/start"
            src={TanStackStartLogo}
            alt="TanStack Start logo"
            label="TanStack"
            tip={tips.tanstack}
            logoBg="bg-white p-1"
          />
          <SkillsMapItem
            {...shared}
            id="astro"
            href="https://astro.build/"
            src={AstroLogo}
            alt="Astro logo"
            label="Astro"
            tip={tips.astro}
          />
          <SkillsMapItem
            {...shared}
            id="react"
            href="https://react.dev/"
            src={ReactLogo}
            alt="React logo"
            label="React"
            tip={tips.react}
          />
        </div>
      </div>
      <div
        class="relative flex w-full items-center justify-around rounded-xl border border-dashed border-white py-6 md:px-8"
      >
        <div
          class="absolute -top-3 left-3 h-6 rounded bg-zinc-800 px-2 pt-1 text-xs"
        >
          Databases
        </div>
        <div
          class="grid w-full grid-cols-3 items-center justify-around py-4 md:py-10"
        >
          <SkillsMapItem
            {...shared}
            id="mongodb"
            href="https://www.mongodb.com/"
            src={MongoDB}
            alt="MongoDB logo"
            label="NoSQL"
            tip={tips.mongodb}
          />
          <SkillsMapItem
            {...shared}
            id="sqlite"
            href="https://sqlite.org/index.html"
            src={SQLite}
            alt="SQLite logo"
            label="SQLite"
            tip={tips.sqlite}
          />
          <SkillsMapItem
            {...shared}
            id="postgresql"
            href="https://www.postgresql.org/"
            src={PostgreSQL}
            alt="PostgreSQL logo"
            label="PostgreSQL"
            tip={tips.postgresql}
          />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .section {
    position: relative;
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    border: 1px dashed white;
    padding: 1rem;
  }
</style>
