---
import { siteConfig } from "@/config/site";
import { getLocale } from "src/lib/routes-helpers";
import { Icon } from "astro-icon/components";
import type { I18nFooter } from "src/i18n/footer/type";
import { getI18n } from "src/i18n/utils";

const locale = getLocale(Astro.params);
const footer = await getI18n<I18nFooter>("footer", locale);

const localePrefix = locale === "en" ? "" : "/" + locale;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto w-full pt-16 pb-8 print:hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="border-t border-zinc-800"></div>

    <div
      class="flex flex-col items-center gap-6 pt-8 sm:flex-row sm:justify-between"
    >
      <!-- Social icons -->
      <address class="flex items-center gap-5 not-italic">
        <a
          href={siteConfig.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
          class="text-zinc-500 transition-colors hover:text-zinc-200"
        >
          <Icon name="mdi:linkedin" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={siteConfig.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          title="Instagram"
          class="text-zinc-500 transition-colors hover:text-zinc-200"
        >
          <Icon name="mdi:instagram" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
          class="text-zinc-500 transition-colors hover:text-zinc-200"
        >
          <Icon name="mdi:github" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={siteConfig.gitlab}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitLab"
          title="GitLab"
          class="text-zinc-500 transition-colors hover:text-zinc-200"
        >
          <Icon name="mdi:gitlab" class="size-5" aria-hidden="true" />
        </a>
      </address>

      <!-- Copyright + Legal -->
      <div
        class="font-body flex flex-col items-center gap-3 text-xs text-zinc-500 sm:flex-row sm:gap-0"
      >
        <span>&copy; {currentYear} {siteConfig.title}</span>
        <span class="hidden sm:inline sm:mx-3">&middot;</span>
        <div class="flex items-center gap-3">
          <a
            href={`${localePrefix}/privacy-policy`}
            class="transition-colors hover:text-zinc-300"
          >
            {footer.privacyPolicy}
          </a>
          <span>&middot;</span>
          <a
            href={`${localePrefix}/terms-and-conditions`}
            class="transition-colors hover:text-zinc-300"
          >
            {footer.terms}
          </a>
          <span>&middot;</span>
          <a
            href={`${localePrefix}/impressum`}
            class="transition-colors hover:text-zinc-300"
          >
            {footer.impressum}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
