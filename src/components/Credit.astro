---
/**
 * Frosted-pill credit/copyright overlay. Positions itself absolutely;
 * the parent element must establish a positioning context (position: relative).
 *
 * Shared by Slide.astro (full-screen presentation slides) and Figure.astro
 * (inline content images). Keep visual changes here so both surfaces stay
 * consistent.
 *
 * Each credit line can be a plain string or a `{ name, href }` object that
 * renders the name as an external link. "© " is added in front unless the
 * line already has it or names a public-domain creator (see lib/credit.ts).
 * A plain string that names an entity (src/config/entities.ts) links to that
 * entity's sources page, which lists every page using its images.
 */
import { copyrightMark } from "@/lib/credit";
import { entityForCredit, sourcesHref } from "@/lib/entities";
import { siteConfig } from "@/config/site";
import { getLocale } from "src/lib/routes-helpers";

export type CreditLink = { name: string; href: string };
export type CreditLine = string | CreditLink;

interface Props {
  credit: CreditLine | CreditLine[];
  class?: string;
}

const { credit, class: className } = Astro.props;

function isLink(line: CreditLine): line is CreditLink {
  return typeof line === "object" && line !== null && "href" in line;
}

const locale = getLocale(Astro.params, Astro.url);
const lines = (Array.isArray(credit) ? credit : [credit]).map((line) => {
  if (isLink(line)) return { ...line, internal: false };
  const entity = entityForCredit(line);
  return entity
    ? { name: line, href: sourcesHref(entity, locale, siteConfig.defaultLocale), internal: true }
    : line;
});
---

<div
  class:list={[
    "credit-pill absolute z-20 rounded bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm",
    className,
  ]}
>
  {
    lines.map((line) =>
      typeof line === "object" ? (
        <p>
          {copyrightMark(line.name)}
          <a
            href={line.href}
            target={line.internal ? undefined : "_blank"}
            rel={line.internal ? undefined : "noopener noreferrer"}
            class="underline decoration-white/30 underline-offset-2 transition-colors hover:text-white hover:decoration-white/60 focus-visible:text-white"
          >
            {line.name}
          </a>
        </p>
      ) : (
        <p>{`${copyrightMark(line)}${line}`}</p>
      ),
    )
  }
</div>
