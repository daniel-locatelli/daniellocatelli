---
import { Code } from "astro:components";
import * as interfaces from "../../../lib/notion-interfaces";
import Caption from "./Caption.astro";
import { notionLangToShiki } from "src/lib/utils";

import clipboard from "@/assets/ui/clipboard.svg";
import clipboardChecked from "@/assets/ui/clipboard-checked.svg";

export interface Props {
  block: interfaces.Block;
}

const { block } = Astro.props;

const code = block
  .Code!.RichTexts.map(
    (richText: interfaces.RichText) => richText.Text!.Content,
  )
  .join("");
const notionLanguage = block.Code!.Language.toLowerCase();
const language = notionLangToShiki(notionLanguage);
---

<div class="relative mb-1 w-full max-w-full overflow-x-hidden pb-6">
  <div class="rounded-sm">
    <div class="absolute top-0 right-0">
      <button
        class="copy cursor-pointer rounded-sm bg-zinc-600 px-1 py-1"
        data-code={"```" + language + "\n" + code + "```"}
        data-clipboard-src={clipboard.src}
        data-checked-src={clipboardChecked.src}
      >
        <img src={clipboard.src} alt="Copy" class="svg-icon h-4 w-10" />
      </button>
    </div>
    {
      /* prettier-ignore */
      language === 'mermaid' ? (
        <pre class="mermaid p-4">{code}</pre>
      ) : (
 
          <Code code={code} lang={language} class="rounded whitespace-pre-wrap p-4 overflow-auto break-normal leading-6 tabular-nums text-left no-hyphens bg-slate-900 text-sky-600" />
      )
    }
  </div>
  <Caption richTexts={block.Code!.Caption} />
</div>

<script>
  document.querySelectorAll("button.copy").forEach((button) => {
    button.addEventListener("click", (ev) => {
      const btn = ev.currentTarget as HTMLElement;
      const imgTag = btn.querySelector(".svg-icon");
      const code = btn.getAttribute("data-code");
      const clipboardSrc = btn.getAttribute("data-clipboard-src");
      const checkedSrc = btn.getAttribute("data-checked-src");

      navigator.clipboard.writeText(code!);
      if (imgTag && checkedSrc && clipboardSrc) {
        imgTag.setAttribute("src", checkedSrc);
        setTimeout(() => {
          imgTag.setAttribute("src", clipboardSrc);
        }, 1000);
      }
    });
  });
</script>

<script>
  import mermaid from "mermaid";
  mermaid.initialize({ startOnLoad: false, theme: "dark" });
  function init() {
    mermaid.run();
  }

  init();

  document.addEventListener("astro:page-load", init);
</script>
