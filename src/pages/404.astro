---
/**
 * Site-wide 404 page.
 *
 * Rendered on demand (not prerendered) so that Astro's error handler can pass
 * the original request URL through: the locale is taken from the first path
 * segment, which lets `/pt/...` and `/de/...` misses render in their own
 * language with the regular Header and Footer. This file must live at
 * `src/pages/404.astro` (route `/404`); a locale-prefixed variant is not
 * recognised as the error route and Astro falls back to its default template.
 */
import Base from "@/layouts/Base.astro";
import Container from "@/components/Container.astro";
import Logo from "@/assets/ui/logo-dl.svg";
import { getI18n } from "src/i18n/utils";
import type { I18nNotFound } from "src/i18n/notFound/types";
import { getLocale } from "src/lib/routes-helpers";

export const prerender = false;

Astro.response.status = 404;

const locale = getLocale(Astro.params, Astro.url);
const t = await getI18n<I18nNotFound>("notFound", locale);
---

<Base
  meta={{
    title: t.meta.title,
    description: t.meta.description,
    slug: "",
  }}
>
  <Container
    class="not-found font-body flex min-h-svh flex-col items-center justify-center gap-8 py-16 text-center"
  >
    <div class="flex items-center gap-5">
      <Logo
        aria-hidden="true"
        class="h-[1em] w-auto shrink-0 text-6xl sm:text-7xl"
      />
      <p
        class="font-title text-6xl leading-none font-extralight tracking-widest sm:text-7xl"
        aria-hidden="true"
      >
        404
      </p>
    </div>
    <h1 class="font-title text-2xl font-light sm:text-3xl">{t.headline}</h1>
  </Container>
</Base>

<style is:global>
  /* Keep the message centered in the full viewport without the footer adding
     scroll: main spans both grid rows (min 100svh via the Container) and the
     footer overlays the bottom of that same area instead of stacking below. */
  body {
    display: grid;
    grid-template-rows: 1fr auto;
    grid-template-columns: 100%;
    min-height: 100svh;
  }
  body > main {
    grid-row: 1 / -1;
    grid-column: 1;
  }
  body > footer {
    grid-row: 2;
    grid-column: 1;
  }
  /* Short viewports (landscape phones): the overlay would cover the text, so
     stack normally and center the message in the space above the footer. */
  @media (max-height: 560px) {
    body > main {
      grid-row: 1;
    }
    body > main > .not-found {
      min-height: 100%;
      padding-block: 3.5rem 0.5rem; /* clear the fixed header */
    }
  }
</style>
