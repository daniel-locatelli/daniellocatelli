---
import Base from "@/layouts/Base.astro";
export { getStaticPaths } from "src/lib/routes-helpers";
import Logo from "@/assets/ui/logo-dl.svg";
---

<Base
  meta={{
    title: "Page not found",
    description: "No page matching this link",
    slug: "",
  }}
>
  <div class="flex h-full flex-col items-center justify-center gap-4">
    <div class="flex items-center justify-center gap-4">
      <Logo
        aria-label="Daniel Locatelli logo"
        class="inline mix-blend-difference"
      />
      <div class="text-4xl font-extralight">404</div>
    </div>
    <div class="text-2xl font-light">Page not found</div>
  </div>
</Base>
