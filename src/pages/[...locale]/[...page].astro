---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import {
  importCoverImage,
  importImage,
} from "src/lib/blog-helpers";
import Base from "@/layouts/Base.astro";
import { siteConfig, SUPPORTED_LOCALES } from "@/config/site";
import { getFileSlug, getEntrySlug, getEntryLocale } from "src/lib/routes-helpers";

type SubpageEntry =
  | CollectionEntry<"projects">
  | CollectionEntry<"research">
  | CollectionEntry<"teaching">
  | CollectionEntry<"publications">
  | CollectionEntry<"skills">;

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  // Get all non-homepage pages
  const allPages = pages.filter((page) => getFileSlug(page.id) !== "index");

  // Create one path per locale-specific page entry
  const paths = allPages.map((page) => {
    const locale = getEntryLocale(page.id);
    return {
      params: {
        locale: locale === siteConfig.defaultLocale ? undefined : locale,
        page: getFileSlug(page.id),
      },
      props: {
        locale,
        page,
      },
    };
  });

  return paths;
}

interface Props {
  page: CollectionEntry<"pages">;
  locale: string;
}

const { page, locale } = Astro.props as Props;
const { Content } = await render(page);

// Map page slugs to their respective subpage collections
const DATABASE_MAPPING: Record<string, string[]> = {
  projects: ["projects"],
  research: ["research", "publications"],
  teaching: ["teaching"],
  // Add other mappings as needed
};

// Fetch subpages based on page slug
let subpages: SubpageEntry[] = [];
const pageSlug = getFileSlug(page.id);
const dbNames = DATABASE_MAPPING[pageSlug] || [];

for (const dbName of dbNames) {
  // @ts-ignore
  const collection = await getCollection(dbName);
  subpages.push(...(collection as unknown as SubpageEntry[]));
}

// Flatten and sort pages
const sortedSubpages = subpages
  .filter((p) => getEntryLocale(p.id) === locale)
  .filter((p) => !getFileSlug(p.id).startsWith("_"))
  .sort((a, b) => {
    if (!a.data.DateStart) return 1;
    if (!b.data.DateStart) return -1;
    return (
      new Date(b.data.DateStart).getTime() -
      new Date(a.data.DateStart).getTime()
    );
  });

// Errors with images? Make sure to build "npm run build"
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/content/**/*.{jpeg,jpg,png,tiff,webp,gif,svg,avif}",
);

// Pre-process images for all subpages to avoid async map in render
// Use Thumbnail for cards if available, falling back to Cover
const sortedSubpagesWithImages = await Promise.all(
  sortedSubpages.map(async (subpage) => {
    const image =
      (await importImage(subpage, images, "Thumbnail")) ||
      (await importCoverImage(subpage, images));
    const coverImage = await importCoverImage(subpage, images);
    const coverSrc = coverImage?.src || "";
    return { ...subpage, image, coverSrc };
  }),
);

let coverUrl = "";
const pageImage = await importCoverImage(page, images);
if (pageImage) {
  coverUrl = pageImage.src;
} else if (page.data.Cover) {
  const cover = page.data.Cover;
  coverUrl = typeof cover === "string" ? cover : cover.Url;
}
---

<Base
  meta={{
    title: page.data.Name,
    description: page.data.Description,
    coverImage: coverUrl,
    coverAlt: page.data.CoverAlt || "Cover image",
    slug: pageSlug,
  }}
>
  <main id="main" class="pt-12 pb-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="mb-12">
        <h1
          class="pt-4 text-2xl tracking-tight text-white sm:pt-12 sm:text-3xl"
        >
          {page.data.Name}
        </h1>
        <div
          class="prose mt-4 max-w-none text-xl text-zinc-400"
        >
          <Content />
        </div>
      </header>

      {
        sortedSubpagesWithImages.length > 0 ? (
          <div
            data-subpage-container
            class="flex flex-col gap-8"
            style="visibility:hidden"
          >
            {sortedSubpagesWithImages.map((subpage, idx) => {
              const { image } = subpage;
              return (
                <article
                  data-chron-index={idx}
                  class="group relative flex flex-col overflow-hidden rounded-2xl bg-zinc-900 transition-all hover:shadow-2xl"
                >
                  <a
                    href={`/${locale === siteConfig.defaultLocale ? "" : `${locale}/`}${getEntrySlug(subpage)}`}
                    class="flex h-full flex-col"
                    data-astro-prefetch
                    data-cover-src={subpage.coverSrc || undefined}
                  >
                    <div class="relative overflow-hidden">
                      {image && (image.format === "svg" ? (
                        <img
                          class="object-cover transition-transform duration-500 group-hover:scale-110"
                          src={image.src}
                          alt={subpage.data.CoverAlt || ""}
                          width={image.width}
                          height={image.height}
                          loading={idx < 8 ? "eager" : "lazy"}
                          decoding="async"
                        />
                      ) : (
                        <Image
                          class="object-cover transition-transform duration-500 group-hover:scale-110"
                          src={image}
                          alt={subpage.data.CoverAlt || ""}
                          loading={idx < 8 ? "eager" : "lazy"}
                          decoding="async"
                          widths={[400, 800]}
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        />
                      ))}
                      <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent opacity-60 transition-opacity group-hover:opacity-40 lg:hidden" />
                      {/* Desktop Hover Overlay */}
                      <div class="absolute inset-0 hidden items-center justify-center bg-black/60 opacity-0 transition-opacity duration-300 group-hover:opacity-100 lg:flex">
                        <h2
                          class="px-6 text-center text-2xl text-pretty text-white"
                          aria-label={subpage.data.Name}
                        >
                          {subpage.data.Name}
                        </h2>
                      </div>
                    </div>
                    <div class="flex flex-1 flex-col justify-end p-6 lg:hidden">
                      <h2
                        class="group-hover:text-primary-400 text-xl font-bold text-white transition-colors"
                        aria-label={subpage.data.Name}
                      >
                        {subpage.data.Name}
                      </h2>
                      {subpage.data.Description && (
                        <p class="mt-2 line-clamp-2 text-sm text-zinc-300">
                          {subpage.data.Description}
                        </p>
                      )}
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="rounded-2xl border border-zinc-800 p-12 text-center text-zinc-500">
            No items found.
          </div>
        )
      }
      <script is:inline>
        (function () {
          function setupCoverPreload() {
            var links = document.querySelectorAll("a[data-cover-src]");
            var preloaded = new Set();
            Array.prototype.forEach.call(links, function (link) {
              link.addEventListener(
                "mouseenter",
                function () {
                  var src = link.dataset.coverSrc;
                  if (!src || preloaded.has(src)) return;
                  preloaded.add(src);
                  var preloadLink = document.createElement("link");
                  preloadLink.rel = "prefetch";
                  preloadLink.as = "image";
                  preloadLink.href = src;
                  document.head.appendChild(preloadLink);
                },
                { once: true },
              );
            });
          }

          function getColumnCount() {
            if (window.matchMedia("(min-width: 1024px)").matches) return 3;
            if (window.matchMedia("(min-width: 640px)").matches) return 2;
            return 1;
          }

          function layoutColumns() {
            var container = document.querySelector("[data-subpage-container]");
            if (!container) return;

            var cards = Array.prototype.slice
              .call(container.querySelectorAll("[data-chron-index]"))
              .sort(function (a, b) {
                return Number(a.dataset.chronIndex) - Number(b.dataset.chronIndex);
              });

            var cols = getColumnCount();

            container.replaceChildren();

            if (cols === 1) {
              container.className = "flex flex-col gap-8";
              cards.forEach(function (card) {
                container.appendChild(card);
              });
            } else {
              container.className =
                "grid gap-8 " + (cols === 2 ? "grid-cols-2" : "grid-cols-3");
              var wrappers = [];
              for (var i = 0; i < cols; i++) {
                var wrapper = document.createElement("div");
                wrapper.className = "flex flex-col gap-8";
                container.appendChild(wrapper);
                wrappers.push(wrapper);
              }
              cards.forEach(function (card, i) {
                wrappers[i % cols].appendChild(card);
              });
            }

            // Reveal the container only after it's in its final layout, so the
            // initial SSR state (flex-col full-width) is never painted. See
            // style="visibility:hidden" on the container above.
            container.style.visibility = "";
          }

          // Synchronous first run at parse time, before the first paint of the
          // container. This is why the script uses is:inline instead of a
          // bundled module script: modules are deferred to DOMContentLoaded,
          // which is too late to prevent the flat-layout flash.
          layoutColumns();
          setupCoverPreload();

          // Re-run on breakpoint changes and Astro view-transition navigations.
          window
            .matchMedia("(min-width: 1024px)")
            .addEventListener("change", layoutColumns);
          window
            .matchMedia("(min-width: 640px)")
            .addEventListener("change", layoutColumns);
          document.addEventListener("astro:page-load", function () {
            layoutColumns();
            setupCoverPreload();
          });
        })();
      </script>
    </div>
  </main>
</Base>
