---
import { getCollection } from "astro:content";
import { DevModelName, ProdModelName } from "@/config/ai";
import homepageCover from "@/assets/content/homepage/homepage-cover.jpeg";
import Base from "@/layouts/Base.astro";
import HeroChat from "@/components/HeroChat";
import type { I18nHome } from "src/i18n/home/types";
import { getI18n } from "src/i18n/utils";
import { getLocale } from "src/lib/routes-helpers";
import { publishedEssays, essayHref, formatEssayMonth } from "src/lib/essays";

export { getStaticPaths } from "src/lib/routes-helpers";

const locale = getLocale(Astro.params);
const home = await getI18n<I18nHome>("home", locale);
const essays = publishedEssays(await getCollection("essays"), locale);
---

<Base
  meta={{
    title: home.meta.title,
    description: home.meta.description,
    coverAlt: home.meta.coverAlt,
    coverImage: homepageCover.src,
    slug: "",
  }}
>
  {
    /*
    Chat mode (see HeroChat.tsx) clears the page down to the conversation.
    Restore it before first paint when this session left the page mid-chat,
    so a visitor coming back from a linked page does not see the homepage
    flash first. Inline so it re-runs on every ClientRouter visit.
  */
  }
  <script is:inline>
    try {
      var s = JSON.parse(sessionStorage.getItem("hero-chat:v1") || "null");
      if (s && s.mode === "chat")
        document.documentElement.setAttribute("data-hero-chat", "");
    } catch (e) {}
  </script>
  <div
    data-home-shell
    class="mx-auto w-full max-w-[688px] px-6 pt-18 pb-8 sm:pt-30"
  >
    <section data-home-extra aria-labelledby="home-name">
      <h1
        id="home-name"
        class="font-title text-4xl leading-tight font-semibold tracking-[0.01em] text-zinc-100 sm:text-[44px]"
      >
        Daniel Locatelli
      </h1>
      <p class="mt-3.5 text-[15px] leading-normal text-zinc-400">
        {home.intro.role}
      </p>
      <p
        class="mt-7 max-w-[36em] text-[17px] leading-relaxed text-pretty text-zinc-100"
      >
        {home.intro.bio}
      </p>
    </section>

    <section
      data-hero-section
      class="mt-11 sm:mt-14"
      aria-label={home.chat.headerTitle}
    >
      <HeroChat
        client:load
        modelName={import.meta.env.DEV ? DevModelName : ProdModelName}
        labels={home.chat}
      />
    </section>

    {
      essays.length > 0 && (
        <section
          data-home-extra
          class="mt-18 sm:mt-24"
          aria-labelledby="home-essays"
        >
          <h2
            id="home-essays"
            class="border-b border-zinc-800 pb-3.5 text-xs font-medium tracking-[0.12em] text-green-400 uppercase"
          >
            {home.essays.title}
          </h2>
          <ol>
            {essays.map((essay) => (
              <li>
                <a
                  href={essayHref(essay, locale)}
                  class="group block border-b border-zinc-800 py-7 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-400"
                >
                  <span class="font-title block text-[23px] leading-snug font-semibold text-balance text-zinc-100 group-hover:text-green-400 sm:text-[26px]">
                    {essay.data.Name}
                  </span>
                  {essay.data.Description && (
                    <span class="mt-2.5 block max-w-[34em] text-[17px] leading-relaxed text-pretty text-zinc-400">
                      {essay.data.Description}
                    </span>
                  )}
                  <span class="mt-3.5 block text-[13px] text-zinc-400">
                    {formatEssayMonth(essay.data.DateStart!, locale)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>

  <style is:global>
    html[data-hero-chat] [data-home-extra],
    html[data-hero-chat] body > footer {
      display: none;
    }
    html[data-hero-chat] [data-home-shell] {
      padding-top: 5rem;
    }
    html[data-hero-chat] [data-hero-section] {
      margin-top: 0;
    }
  </style>
</Base>
