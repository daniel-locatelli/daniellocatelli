---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  importCoverImage,
  generateBlurDataUrl,
} from "../../lib/blog-helpers.ts";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { siteConfig, SUPPORTED_LOCALES } from "@/config/site";
import { getLocale, getEntrySlug, getEntryLocale, getFileSlug } from "src/lib/routes-helpers";
import { getI18n } from "src/i18n/utils";
import type { I18nSubpage } from "src/i18n/subpage/type";

type SubpageEntry =
  | CollectionEntry<"projects">
  | CollectionEntry<"research">
  | CollectionEntry<"teaching">
  | CollectionEntry<"publications">
  | CollectionEntry<"skills">;

const locale = getLocale(Astro.params);

const t = await getI18n<I18nSubpage>("subpage", locale);

export async function getStaticPaths() {
  const collections = [
    "projects",
    "research",
    "teaching",
    "publications",
    "skills",
  ];

  const allSubpages = (
    await Promise.all(collections.map((c) => getCollection(c as any)))
  ).flat() as SubpageEntry[];

  const paths = [];

  for (const locale of SUPPORTED_LOCALES) {
    const isDefaultLocale = locale === siteConfig.defaultLocale;

    for (const subpage of allSubpages) {
      // Only include if the subpage belongs to this locale
      if (getEntryLocale(subpage.id) !== locale) continue;
      // Skip unpublished entries (filenames starting with _)
      if (getFileSlug(subpage.id).startsWith("_")) continue;

      paths.push({
        params: {
          subpage: getEntrySlug(subpage),
          locale: isDefaultLocale ? undefined : locale,
        },
        props: {
          subpage,
          locale,
        },
      });
    }
  }

  return paths;
}

interface Props {
  subpage: SubpageEntry;
}

const { subpage } = Astro.props as Props;
const slug = getEntrySlug(subpage);
const fileSlug = getFileSlug(subpage.id);
const entryLocale = getEntryLocale(subpage.id);

const { Content } = await render(subpage);

// Detect a matching presentation (same slug + locale, not a draft).
const presentations = await getCollection("presentations");
const matchingDeck = presentations.find(
  (p) =>
    getEntryLocale(p.id) === entryLocale &&
    getFileSlug(p.id) === fileSlug &&
    !getFileSlug(p.id).startsWith("_"),
);
const deckBasePath =
  entryLocale === siteConfig.defaultLocale ? "" : `/${entryLocale}`;
const deckHref = matchingDeck
  ? `${deckBasePath}/presentations/${fileSlug}`
  : null;

// Getting images dynamically with import.meta.glob()
// It only accepts string literals
// https://docs.astro.build/en/recipes/dynamically-importing-images/
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/content/**/*.{jpeg,jpg,png,tiff,webp,gif,svg,avif}",
);

// Cover image
const image = await importCoverImage(subpage, images);

let coverUrl = "";
let blurDataUrl = "";
if (image) {
  coverUrl = image.src;
  const fsPath = (image as any).fsPath as string;
  if (fsPath) {
    blurDataUrl = await generateBlurDataUrl(fsPath);
  }
} else if (subpage.data.Cover) {
  const cover = subpage.data.Cover;
  coverUrl = typeof cover === "string" ? cover : cover.Url;
}

const isLetterbox = subpage.data.CoverFit === "contain";
const focalStyle = subpage.data.CoverFocal
  ? `object-position: ${subpage.data.CoverFocal}`
  : undefined;
const foregroundClass = isLetterbox
  ? "hero-img absolute inset-0 h-full w-full object-contain opacity-0 md:object-cover"
  : "hero-img absolute inset-0 h-full w-full object-cover opacity-0";
---

<Base
  meta={{
    title: subpage.data.Name,
    description: subpage.data.Description,
    coverImage: coverUrl,
    coverAlt: subpage.data.CoverAlt || "Cover image",
    slug: slug,
  }}
>
  <Fragment slot="after-head" />
  {
    image && (
      <div class="hero-image relative mb-8 h-[60svh] w-full overflow-hidden md:h-svh">
        {isLetterbox &&
          (blurDataUrl ? (
            <img
              src={blurDataUrl}
              class="absolute inset-0 h-full w-full object-cover scale-110 blur-xl md:hidden"
              aria-hidden="true"
              alt=""
              loading="eager"
              decoding="async"
            />
          ) : image.format === "svg" ? (
            <img
              src={image.src}
              class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl md:hidden"
              aria-hidden="true"
              alt=""
              width={image.width}
              height={image.height}
              loading="eager"
              decoding="async"
            />
          ) : (
            <Image
              src={image}
              width={40}
              class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl md:hidden"
              aria-hidden="true"
              alt=""
              loading="eager"
              decoding="async"
            />
          ))}
        {image.format === "svg" ? (
          <img
            class={foregroundClass}
            style={focalStyle}
            src={image.src}
            alt={subpage.data.CoverAlt || ""}
            width={image.width}
            height={image.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        ) : (
          <Image
            class={foregroundClass}
            style={focalStyle}
            src={image}
            alt={subpage.data.CoverAlt || ""}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )}
        <a
          href="#content"
          aria-label="Scroll to content"
          class="scroll-chevron absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 animate-bounce transition-opacity duration-300 md:block"
        >
          <div class="flex size-10 items-center justify-center rounded-full bg-zinc-950">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-white"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </a>
      </div>
    )
  }
  <section
    id="content"
    class="font-body flex w-full max-w-full flex-col items-center justify-center scroll-mt-16"
  >
    <div class="w-full max-w-full overflow-x-hidden sm:max-w-2xl">
      <h1
        class="title font-title mb-8 px-4 text-4xl font-normal text-balance text-zinc-100 sm:px-0"
      >
        {subpage.data.Name}
      </h1>
      {
        deckHref && (
          <a
            href={deckHref}
            class="mx-4 mb-8 inline-flex w-fit items-center gap-2 rounded-full border border-green-600 bg-green-600/10 px-4 py-2 text-sm font-medium text-green-400 transition hover:bg-green-600/20 hover:text-green-300 sm:mx-0"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
            {t.openPresentation}
          </a>
        )
      }
      <table
        class="table-auto border-separate border-spacing-x-4 px-4 text-left text-zinc-200 sm:px-0 *:align-text-top"
      >
        <tbody>
        {
          subpage.data.DateEnd ? (
            <tr>
              <th class="font-body font-bold">{t.date}</th>
              <td>{subpage.data.DateEnd}</td>
            </tr>
          ) : subpage.data.DateStart ? (
            <tr>
              <th class="font-body font-bold">{t.date}</th>
              <td>{subpage.data.DateStart}</td>
            </tr>
          ) : null
        }
        {
          subpage.data.Organization && (
              <tr>
                <th>{t.organization}</th>
                <td>{subpage.data.Organization}</td>
              </tr>
            )
        }
        {
          subpage.data.Client && (
            <tr>
              <th>{t.client}</th>
              <td>{subpage.data.Client}</td>
            </tr>
          )
        }
        </tbody>
        <tbody>
        <tr><td colspan="2" class="py-1.5"><hr class="border-zinc-800" /></td></tr>
        {
          subpage.data.Authors &&
            Array.isArray(subpage.data.Authors) &&
            subpage.data.Authors.length > 0 && (
              <tr>
                {subpage.data.Authors.length === 1 ? (
                  <th>{t.author}</th>
                ) : (
                  <th>{t.authors}</th>
                )}
                <td>
                  {subpage.data.Authors.map((author: any, index: number) => {
                    const name =
                      typeof author === "string" ? author : author.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Supervisors &&
            Array.isArray(subpage.data.Supervisors) &&
            subpage.data.Supervisors.length > 0 && (
              <tr>
                {subpage.data.Supervisors.length === 1 ? (
                  <th>{t.supervisor}</th>
                ) : (
                  <th>{t.supervisors}</th>
                )}
                <td>
                  {subpage.data.Supervisors.map((sup: any, index: number) => {
                    const name = typeof sup === "string" ? sup : sup.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Advisors &&
            Array.isArray(subpage.data.Advisors) &&
            subpage.data.Advisors.length > 0 && (
              <tr>
                {subpage.data.Advisors.length === 1 ? (
                  <th>{t.advisor}</th>
                ) : (
                  <th>{t.advisors}</th>
                )}
                <td>
                  {subpage.data.Advisors.map((adv: any, index: number) => {
                    const name = typeof adv === "string" ? adv : adv.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Coordinators &&
            Array.isArray(subpage.data.Coordinators) &&
            subpage.data.Coordinators.length > 0 && (
              <tr>
                {subpage.data.Coordinators.length === 1 ? (
                  <th>{t.coordinator}</th>
                ) : (
                  <th>{t.coordinators}</th>
                )}
                <td>
                  {subpage.data.Coordinators.map((c: any, index: number) => {
                    const name = typeof c === "string" ? c : c.name;
                    const role = typeof c === "string" ? null : c.role;
                    const prefix = index === 0 ? "" : ", ";
                    return role ? (
                      <span>{prefix}{name} ({role})</span>
                    ) : (
                      <span>{prefix}{name}</span>
                    );
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Director &&
            Array.isArray(subpage.data.Director) &&
            subpage.data.Director.length > 0 && (
              <tr>
                {subpage.data.Director.length === 1 ? (
                  <th>{t.director}</th>
                ) : (
                  <th>{t.directors}</th>
                )}
                <td>
                  {subpage.data.Director.map((director: any, index: number) => {
                    const name =
                      typeof director === "string" ? director : director.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Manager &&
            Array.isArray(subpage.data.Manager) &&
            subpage.data.Manager.length > 0 && (
              <tr>
                {subpage.data.Manager.length === 1 ? (
                  <th>{t.manager}</th>
                ) : (
                  <th>{t.managers}</th>
                )}
                <td>
                  {subpage.data.Manager.map((manager: any, index: number) => {
                    const name =
                      typeof manager === "string" ? manager : manager.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Team &&
            Array.isArray(subpage.data.Team) &&
            subpage.data.Team.length > 0 && (
              <tr>
                <th>{t.team}</th>
                <td class="text-balance">
                  {subpage.data.Team.map((member: any, index: number) => {
                    const name =
                      typeof member === "string" ? member : member.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        </tbody>
        <tbody>
        <tr><td colspan="2" class="py-1.5"><hr class="border-zinc-800" /></td></tr>
        {
          subpage.data.Place && subpage.data.Place !== "" && (
            <tr>
              <th>{t.place}</th>
              <td>{subpage.data.Place}</td>
            </tr>
          )
        }
        {
          ((subpage.data.City &&
            Array.isArray(subpage.data.City) &&
            subpage.data.City.length > 0) ||
            (subpage.data.Country && subpage.data.Country !== "")) && (
              <tr>
                <th>{t.location}</th>
                <td>
                  {[
                    ...(subpage.data.City && Array.isArray(subpage.data.City) && subpage.data.City.length > 0
                      ? [subpage.data.City.join(", ")]
                      : []),
                    ...(subpage.data.Country && subpage.data.Country !== ""
                      ? [subpage.data.Country]
                      : []),
                  ].join(", ")}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Development && subpage.data.Development.length > 0 && (
            <tr>
              <th>{t.development}</th>
              <td>
                {subpage.data.Development.map((dev: any, index: number) => {
                  const name = typeof dev === "string" ? dev : dev.name;
                  if (index === 0) {
                    return <span>{name}</span>;
                  } else {
                    return <span>, {name}</span>;
                  }
                })}
              </td>
            </tr>
          )
        }
        {
          subpage.data.Language && subpage.data.Language.length > 0 && (
            <tr>
              {!Array.isArray(subpage.data.Language) || subpage.data.Language.length === 1 ? (
                <th>{t.language}</th>
              ) : (
                <th>{t.languages}</th>
              )}
              <td>
                {Array.isArray(subpage.data.Language) ? (
                  subpage.data.Language.map((lang: any, index: number) => {
                    const name = typeof lang === "string" ? lang : lang.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })
                ) : (
                  <span>{subpage.data.Language}</span>
                )}
              </td>
            </tr>
          )
        }
        {
          subpage.data.Link !== undefined &&
            ((Array.isArray(subpage.data.Link) &&
              subpage.data.Link.length > 0) ||
              typeof subpage.data.Link === "string" ||
              (typeof subpage.data.Link === "object" && "Href" in subpage.data.Link)) && (
              <tr>
                <th>{t.link}</th>
                <td>
                  {(() => {
                    const link = subpage.data.Link;
                    if (!link) return null;

                    if (Array.isArray(link)) {
                      return link.map((item: any) => {
                        const href = typeof item === "string" ? item : (item.Href || item.Text || "#");
                        const text = typeof item === "string" ? item : (item.Text || item.Href || "");
                        return (
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mr-2 text-green-500 transition hover:text-green-400"
                          >
                            {text}
                          </a>
                        );
                      });
                    }

                    if (typeof link === "object" && "Href" in link) {
                      const l = link as { Text: string; Href: string };
                      return (
                        <a
                          href={l.Href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-green-500 transition hover:text-green-400"
                        >
                          {l.Text}
                        </a>
                      );
                    }

                    if (typeof link === "string") {
                      return (
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-green-500 transition hover:text-green-400"
                        >
                          {link}
                        </a>
                      );
                    }

                    return null;
                  })()}
                </td>
              </tr>
            )
        }
        {
          subpage.data.Apps &&
            Array.isArray(subpage.data.Apps) &&
            subpage.data.Apps.length > 0 && (
              <tr>
                <th>{t.apps}</th>
                <td>
                  {subpage.data.Apps.map((app: any, index: number) => {
                    const name = typeof app === "string" ? app : app.name;
                    if (index === 0) {
                      return <span>{name}</span>;
                    } else {
                      return <span>, {name}</span>;
                    }
                  })}
                </td>
              </tr>
            )
        }
        {
          subpage.data.References !== undefined &&
            subpage.data.References.length > 0 && (
              <tr>
                <th>{t.references}</th>
                <td>
                  {subpage.data.References.map((ref: any) => {
                    if (typeof ref === "string") return <span>{ref}</span>;
                    if (ref.Href) return <a href={ref.Href} target="_blank" rel="noopener noreferrer" class="mr-2 text-green-500 transition hover:text-green-400">{ref.Text || ref.Href}</a>;
                    return <span>{ref.PlainText || ref.Text || ""}</span>;
                  })}
                </td>
              </tr>
            )
        }
        </tbody>
      </table>
      <div class="prose my-8 max-w-none px-4 text-zinc-200 sm:px-0">
        <Content />
      </div>
      {
        subpage.data.OtherLinks &&
          subpage.data.OtherLinks.length > 0 && (
            <div class="mt-8">
              <h2 class="font-title mb-4 text-xl text-zinc-100">
                {t.otherLinks}
              </h2>
              <div class="flex flex-col gap-3">
                {subpage.data.OtherLinks.map((link: any) => (
                  <a
                    href={link.Href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-col gap-1 rounded-lg border border-zinc-700 px-4 py-3 transition hover:border-green-600 hover:bg-zinc-900"
                  >
                    <span class="font-body text-sm font-medium text-green-500">
                      {link.Text}
                    </span>
                    {link.Description && (
                      <span class="text-xs text-zinc-400">
                        {link.Description}
                      </span>
                    )}
                    <span class="truncate text-xs text-zinc-500">
                      {link.Href}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
      }
    </div>
  </section>
</Base>

<script>
  import mermaid from "mermaid";
  mermaid.initialize({
    startOnLoad: false,
    theme: "dark",
    darkMode: true,
  });
  document.addEventListener("astro:page-load", async () => {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (blocks.length === 0) return;
    for (const block of blocks) {
      const code = block.textContent ?? "";
      const wrapper = document.createElement("div");
      wrapper.className = "mermaid-diagram my-4 overflow-x-auto";
      const pre = document.createElement("pre");
      pre.className = "mermaid";
      pre.textContent = code;
      wrapper.appendChild(pre);
      block.replaceWith(wrapper);
    }
    try {
      await mermaid.run({ querySelector: ".mermaid" });
      document
        .querySelectorAll<SVGElement>(".mermaid-diagram svg")
        .forEach((svg) => svg.setAttribute("role", "img"));
    } catch (e) {
      console.warn("Mermaid run failed", e);
    }
  });
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  th {
    font-weight: 300;
  }

  @media (max-width: 639px) {
    .prose :global(img),
    .prose :global(figure),
    .prose :global(video) {
      margin-left: -1rem;
      margin-right: -1rem;
      max-width: calc(100% + 2rem);
      width: calc(100% + 2rem);
    }
  }

  .hero-img {
    transition: opacity 0.3s ease;
  }
</style>

<script>
  function setupScrollChevron() {
    const chevron = document.querySelector(".scroll-chevron");
    if (!chevron) return;

    const hero = chevron.closest(".hero-image");
    if (!hero) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        (chevron as HTMLElement).style.opacity = entry.isIntersecting
          ? "1"
          : "0";
        (chevron as HTMLElement).style.pointerEvents = entry.isIntersecting
          ? "auto"
          : "none";
      },
      { threshold: 0.5 },
    );

    observer.observe(hero);
  }

  document.addEventListener("astro:page-load", setupScrollChevron);
</script>

<script>
  function setupHeroReveal(skipTransition: boolean) {
    document.querySelectorAll<HTMLImageElement>(".hero-img").forEach((img) => {
      if (skipTransition) {
        img.style.transition = "none";
      }

      if (img.complete) {
        img.style.opacity = "1";
      } else {
        img.addEventListener(
          "load",
          () => {
            img.style.opacity = "1";
          },
          { once: true },
        );
      }
    });
  }

  // Client-side navigation (cached): skip transition to avoid flash
  document.addEventListener("astro:after-swap", () => setupHeroReveal(true));
  // Initial page load: normal 300ms fade-in
  document.addEventListener("astro:page-load", () => setupHeroReveal(false));
</script>

<div
  id="lightbox"
  data-zoomed="false"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
>
  <button
    id="lightbox-close"
    aria-label="Close lightbox"
    class="absolute top-4 right-4 z-10 cursor-pointer text-3xl text-white/70 transition hover:text-white"
    >&times;</button
  >
  <div
    id="lightbox-scroll"
    class="flex max-h-[95vh] max-w-[95vw] items-center justify-center select-none data-[zoomed=true]:overflow-auto"
  >
    <img
      id="lightbox-img"
      draggable="false"
      class="rounded object-contain max-h-[90vh] max-w-[90vw] data-[zoomed=true]:max-h-none data-[zoomed=true]:max-w-none"
      alt=""
    />
  </div>
</div>

<script>
  function pickLargestSrc(img: HTMLImageElement): string {
    const srcset = img.getAttribute("srcset");
    if (srcset) {
      let bestUrl = "";
      let bestWidth = 0;
      for (const entry of srcset.split(",")) {
        const parts = entry.trim().split(/\s+/);
        if (parts.length < 2) continue;
        const url = parts[0];
        const descriptor = parts[parts.length - 1];
        if (!descriptor.endsWith("w")) continue;
        const width = parseInt(descriptor.slice(0, -1), 10);
        if (Number.isFinite(width) && width > bestWidth) {
          bestWidth = width;
          bestUrl = url;
        }
      }
      if (bestUrl) return bestUrl;
    }
    return img.currentSrc || img.src;
  }

  function setupLightbox() {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement | null;
    const lightboxClose = document.getElementById("lightbox-close");
    if (!lightbox || !lightboxImg) return;

    const prose = document.querySelector(".prose");
    if (!prose) return;

    // Make prose images look clickable
    prose.querySelectorAll("img").forEach((img) => {
      img.style.cursor = "zoom-in";
    });

    // Event delegation: click on any image inside .prose
    prose.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName !== "IMG") return;
      const img = target as HTMLImageElement;
      lightboxImg.src = pickLargestSrc(img);
      lightboxImg.alt = img.alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
    });

    function closeLightbox() {
      lightbox!.classList.add("hidden");
      lightbox!.classList.remove("flex");
      lightboxImg!.src = "";
    }

    // Close on backdrop click
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === lightboxClose) {
        closeLightbox();
      }
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  }

  document.addEventListener("astro:page-load", setupLightbox);
</script>

<script>
  // Footnote tooltips. The rehype-footnote-tooltips plugin emits each
  // tooltip with `popover="manual"` so we can promote it into the top layer
  // (escaping ancestor overflow clipping). We position it manually relative
  // to the pill on hover/focus, with viewport-edge clamping and an
  // above-then-below flip when the pill is near the top of the viewport.
  function setupFootnoteTooltips() {
    const refs = document.querySelectorAll<HTMLAnchorElement>("a.footnote-ref");
    refs.forEach((ref) => {
      const sup = ref.parentElement;
      const tooltip = sup?.querySelector<HTMLElement>(".footnote-tooltip");
      if (!sup || !tooltip) return;

      // Defensive: ensure the popover attribute is present even if the rehype
      // plugin's hast property was dropped during HTML serialization. Without
      // it, showPopover() throws silently and the tooltip stays hidden.
      tooltip.setAttribute("popover", "manual");

      let hoverTimer: number | undefined;
      const cancelHide = () => {
        if (hoverTimer !== undefined) {
          window.clearTimeout(hoverTimer);
          hoverTimer = undefined;
        }
      };
      const queueHide = () => {
        cancelHide();
        hoverTimer = window.setTimeout(() => {
          try {
            tooltip.hidePopover();
          } catch {}
        }, 100);
      };

      const show = () => {
        cancelHide();
        // Close any sibling tooltips first so a fast cursor between pills
        // never leaves more than one tooltip on screen.
        document
          .querySelectorAll<HTMLElement>(".footnote-tooltip")
          .forEach((other) => {
            if (other !== tooltip) {
              try {
                other.hidePopover();
              } catch {}
            }
          });
        try {
          tooltip.showPopover();
        } catch {
          return;
        }
        const r = ref.getBoundingClientRect();
        const tw = tooltip.offsetWidth;
        const th = tooltip.offsetHeight;
        const margin = 8;
        let left = r.left + r.width / 2 - tw / 2;
        left = Math.max(
          margin,
          Math.min(left, window.innerWidth - tw - margin),
        );
        let top = r.top - th - margin;
        if (top < margin) top = r.bottom + margin;
        tooltip.style.left = `${Math.round(left)}px`;
        tooltip.style.top = `${Math.round(top)}px`;
      };

      ref.addEventListener("mouseenter", show);
      ref.addEventListener("mouseleave", queueHide);
      ref.addEventListener("focus", show);
      ref.addEventListener("blur", queueHide);
      tooltip.addEventListener("mouseenter", cancelHide);
      tooltip.addEventListener("mouseleave", queueHide);
    });
  }

  document.addEventListener("astro:page-load", setupFootnoteTooltips);
</script>

<script>
  // Body images are tagged with data-preload by rehype-lazy-images. We keep
  // loading="lazy" as a no-JS fallback, but proactively flip to eager once
  // the image is within ~1.5 viewports of the user, so fast scrolls don't
  // hit a per-row network wait. Native loading="lazy" alone has too tight a
  // preload distance for a reading experience.
  function setupBodyImagePreload() {
    const images = document.querySelectorAll<HTMLImageElement>(
      'img[data-preload="true"]',
    );
    if (!("IntersectionObserver" in window) || images.length === 0) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const img = entry.target as HTMLImageElement;
          img.loading = "eager";
          io.unobserve(img);
        }
      },
      { rootMargin: "1500px 0px" },
    );

    images.forEach((img) => io.observe(img));
  }

  document.addEventListener("astro:page-load", setupBodyImagePreload);
</script>
