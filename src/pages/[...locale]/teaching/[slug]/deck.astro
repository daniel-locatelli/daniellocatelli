---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Slides from "@/layouts/Slides.astro";
import { siteConfig, SUPPORTED_LOCALES } from "@/config/site";
import { getEntryLocale, getDeckParentSlug } from "src/lib/routes-helpers";

export async function getStaticPaths() {
  const decks = (await getCollection("decks")) as CollectionEntry<"decks">[];
  const paths = [] as Array<{
    params: { locale: string | undefined; slug: string };
    props: { deck: CollectionEntry<"decks">; locale: string };
  }>;

  for (const locale of SUPPORTED_LOCALES) {
    const isDefault = locale === siteConfig.defaultLocale;
    for (const deck of decks) {
      if (getEntryLocale(deck.id) !== locale) continue;
      const parentSlug = getDeckParentSlug(deck.id);
      // Skip drafts (parent folder prefixed with "_").
      if (parentSlug.startsWith("_")) continue;
      paths.push({
        params: {
          locale: isDefault ? undefined : locale,
          slug: parentSlug,
        },
        props: { deck, locale },
      });
    }
  }

  return paths;
}

interface Props {
  deck: CollectionEntry<"decks">;
  locale: string;
}

const { deck, locale } = Astro.props as Props;
const { Content } = await render(deck);

const parentSlug = getDeckParentSlug(deck.id);

const cover = deck.data.Cover;
const coverUrl = typeof cover === "string" ? cover : cover?.Url ?? "";

const basePath = locale === siteConfig.defaultLocale ? "" : `/${locale}`;
const exitHref = `${basePath}/teaching/${parentSlug}`;
---

<Slides
  meta={{
    title: deck.data.Name,
    description: deck.data.Description ?? "",
    coverImage: coverUrl,
    coverAlt: deck.data.CoverAlt ?? "",
    slug: `teaching/${parentSlug}/deck`,
  }}
  exitHref={exitHref}
>
  <Content />
</Slides>
