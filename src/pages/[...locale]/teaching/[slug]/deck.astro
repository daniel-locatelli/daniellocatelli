---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Slides from "@/layouts/Slides.astro";
import { siteConfig, SUPPORTED_LOCALES } from "@/config/site";
import {
  getEntryLocale,
  getDeckParentSlug,
  getFileSlug,
  getAlternateLocales,
} from "src/lib/routes-helpers";

export async function getStaticPaths() {
  const decks = (await getCollection("decks")) as CollectionEntry<"decks">[];
  const paths = [] as Array<{
    params: { locale: string | undefined; slug: string };
    props: { deck: CollectionEntry<"decks">; locale: string };
  }>;

  for (const locale of SUPPORTED_LOCALES) {
    const isDefault = locale === siteConfig.defaultLocale;
    for (const deck of decks) {
      if (getEntryLocale(deck.id) !== locale) continue;
      const parentSlug = getDeckParentSlug(deck.id);
      // Skip drafts (parent folder prefixed with "_").
      if (parentSlug.startsWith("_")) continue;
      paths.push({
        params: {
          locale: isDefault ? undefined : locale,
          slug: parentSlug,
        },
        props: { deck, locale },
      });
    }
  }

  return paths;
}

interface Props {
  deck: CollectionEntry<"decks">;
  locale: string;
}

const { deck, locale } = Astro.props as Props;
const { Content } = await render(deck);

const parentSlug = getDeckParentSlug(deck.id);

const cover = deck.data.Cover;
const coverUrl = typeof cover === "string" ? cover : (cover?.Url ?? "");

const basePath = locale === siteConfig.defaultLocale ? "" : `/${locale}`;

// Decks are not always translated: hreflang must advertise only the locales
// this deck was actually built for, or it points search engines at 404s.
const alternateLocales = getAlternateLocales(
  (await getCollection("decks")).map((d) => d.id),
  parentSlug,
  getDeckParentSlug,
);

// Only link back to the teaching page if one is actually published for this
// deck in this locale; otherwise "Exit" goes to the locale home instead of a 404.
const hasTeachingPage = (await getCollection("teaching")).some(
  (entry) =>
    getEntryLocale(entry.id) === locale &&
    getFileSlug(entry.id) === parentSlug &&
    !getFileSlug(entry.id).startsWith("_"),
);
const exitHref = hasTeachingPage
  ? `${basePath}/teaching/${parentSlug}`
  : basePath || "/";
---

<Slides
  meta={{
    title: deck.data.Name,
    description: deck.data.Description ?? "",
    coverImage: coverUrl,
    coverAlt: deck.data.CoverAlt ?? "",
    slug: `teaching/${parentSlug}/deck`,
    alternateLocales,
  }}
  exitHref={exitHref}
>
  <Content />
</Slides>
