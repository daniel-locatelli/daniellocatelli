---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { siteConfig } from "@/config/site";
import { getLocale } from "src/lib/routes-helpers";
import { fade } from "astro:transitions";

interface Props {
  meta: SiteMeta;
}

const locale = getLocale(Astro.params);

// ... existing imports

const {
  meta: {
    articleDate,
    description = siteConfig.description,
    coverImage,
    coverAlt,
    title,
    slug,
  },
} = Astro.props;
---

<html lang={locale ? locale : siteConfig.defaultLocale} transition:animate={fade({ duration: "0.15s" })}>
  <head>
    <BaseHead
      articleDate={articleDate}
      description={description}
      coverImage={coverImage}
      coverAlt={coverAlt}
      title={title}
      viewTransition={true}
      slug={slug}
    />
    <slot name="after-head" />
  </head>
  <body class="m-0 h-full max-w-full p-0">
    <Header slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <style>
      html {
        overflow-y: scroll;
      }
    </style>
    <script>
      // Faster smooth scroll for in-page anchor clicks. Native
      // `scroll-behavior: smooth` runs at a browser-fixed ~400-600ms with no
      // API to shorten it; this listener animates over 250ms with a cubic
      // ease and respects `scroll-padding-top` so footnote refs and back-refs
      // still land below the fixed header.
      let bound = false;
      function bindFastAnchorScroll() {
        if (bound) return;
        bound = true;
        const DURATION = 250;
        const easeInOutCubic = (t: number) =>
          t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

        // Capture phase + stopImmediatePropagation so we run before Astro's
        // ClientRouter, which otherwise treats same-page hash clicks as
        // navigations and calls its own pushState (instant jump).
        document.addEventListener(
          "click",
          (e) => {
            if (e.defaultPrevented) return;
            if (e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const a = (e.target as Element | null)?.closest?.(
              'a[href^="#"]',
            ) as HTMLAnchorElement | null;
            if (!a) return;
            const href = a.getAttribute("href");
            if (!href || href.length < 2) return;
            let id: string;
            try {
              id = decodeURIComponent(href.slice(1));
            } catch {
              return;
            }
            const target = document.getElementById(id);
            if (!target) return;
            if (
              window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ) {
              return; // let the browser handle it (it will jump instantly)
            }
            e.preventDefault();
            e.stopImmediatePropagation();
            const padTop =
              parseFloat(
                getComputedStyle(document.documentElement).scrollPaddingTop,
              ) || 0;
            const startY = window.scrollY;
            const targetY =
              target.getBoundingClientRect().top + startY - padTop;
            const distance = targetY - startY;
            if (Math.abs(distance) < 1) {
              history.pushState(null, "", href);
              return;
            }
            const t0 = performance.now();
            const step = (now: number) => {
              const p = Math.min((now - t0) / DURATION, 1);
              window.scrollTo(0, startY + distance * easeInOutCubic(p));
              if (p < 1) requestAnimationFrame(step);
              else history.pushState(null, "", href);
            };
            requestAnimationFrame(step);
          },
          { capture: true },
        );
      }
      bindFastAnchorScroll();
      document.addEventListener("astro:after-swap", bindFastAnchorScroll);
    </script>
    <slot name="after-body" />
  </body>
</html>
