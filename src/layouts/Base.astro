---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { siteConfig } from "@/config/site";
import { getLocale } from "src/lib/routes-helpers";
import { fade } from "astro:transitions";

interface Props {
  meta: SiteMeta;
}

const locale = getLocale(Astro.params);

// ... existing imports

const {
  meta: {
    articleDate,
    description = siteConfig.description,
    coverImage,
    coverAlt,
    title,
    slug,
  },
} = Astro.props;
---

<html lang={locale ? locale : siteConfig.defaultLocale} transition:animate={fade({ duration: "0.15s" })}>
  <head>
    <BaseHead
      articleDate={articleDate}
      description={description}
      coverImage={coverImage}
      coverAlt={coverAlt}
      title={title}
      viewTransition={true}
      slug={slug}
    />
    <slot name="after-head" />
  </head>
  <body class="m-0 h-full max-w-full p-0">
    <Header slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <style>
      html {
        overflow-y: scroll;
      }
    </style>
  </body>
</html>
