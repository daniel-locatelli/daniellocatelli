---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/BaseHead.astro";
import { siteConfig } from "@/config/site";
import { getLocale } from "src/lib/routes-helpers";

interface Props {
  meta: SiteMeta;
  exitHref?: string;
}

const locale = getLocale(Astro.params);

const {
  meta: {
    articleDate,
    description = siteConfig.description,
    coverImage,
    coverAlt,
    title,
    slug,
  },
  exitHref,
} = Astro.props;
---

<html lang={locale ?? siteConfig.defaultLocale}>
  <head>
    <BaseHead
      articleDate={articleDate}
      description={description}
      coverImage={coverImage}
      coverAlt={coverAlt}
      title={title}
      viewTransition={false}
      slug={slug}
    />
    <slot name="after-head" />
  </head>
  <body
    class="m-0 h-svh max-h-svh w-screen max-w-none overflow-hidden bg-black p-0 text-zinc-100"
    style="font-family: 'Montserrat', sans-serif; padding: 0; max-width: none; margin: 0;"
  >
    <main id="deck" class="relative h-svh w-screen">
      <slot />
    </main>

    <!-- HUD: preload + exit + help + presenter + fullscreen (top-right); progress (bottom-right) -->
    <div
      id="deck-hud"
      class="pointer-events-none fixed inset-x-0 top-0 z-30 flex items-start justify-end p-4 transition-opacity duration-300 sm:p-6"
    >
      <div class="pointer-events-auto flex items-center gap-2">
        <div
          id="deck-preload"
          class="flex items-center gap-2 rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 tabular-nums backdrop-blur-sm transition-opacity duration-500"
          aria-live="polite"
        >
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-emerald-400" aria-hidden="true" />
          <span id="deck-preload-text">Preloading…</span>
        </div>
        {
          exitHref && (
            <a
              href={exitHref}
              aria-label="Exit presentation"
              class="cursor-pointer rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm transition hover:bg-black/65 hover:text-zinc-100"
            >
              ← Exit
            </a>
          )
        }
        <button
          id="deck-help"
          aria-label="Show keyboard shortcuts"
          class="cursor-pointer rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm transition hover:bg-black/65 hover:text-zinc-100"
          type="button"
        >
          ?
        </button>
        <button
          id="deck-presenter-btn"
          aria-label="Open presenter window"
          title="Open presenter window (P)"
          class="cursor-pointer rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm transition hover:bg-black/65 hover:text-zinc-100"
          type="button"
        >
          ◫
        </button>
        <button
          id="deck-fullscreen"
          aria-label="Toggle fullscreen"
          class="cursor-pointer rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm transition hover:bg-black/65 hover:text-zinc-100"
          type="button"
        >
          ⛶
        </button>
      </div>
    </div>

    <div
      id="deck-presenter-overlay"
      class="pointer-events-none fixed inset-x-0 top-3 z-30 hidden flex-col items-center gap-2"
    >
      <div
        id="deck-timer"
        class="rounded-full bg-black/50 px-4 py-2 text-xl font-bold tracking-wider text-zinc-50 backdrop-blur-sm tabular-nums"
        style="font-family: 'Montserrat', sans-serif;"
      >
        00:00
      </div>
      <div
        id="deck-next-hint"
        class="max-w-[60vw] truncate rounded-full bg-black/50 px-3 py-1.5 text-xs text-white/60 backdrop-blur-sm"
        style="font-family: 'Montserrat', sans-serif;"
      >
        Next: …
      </div>
    </div>

    <div
      id="deck-progress"
      class="pointer-events-none fixed right-4 bottom-4 z-30 rounded bg-black/50 px-3 py-1.5 text-xs text-white/60 tabular-nums backdrop-blur-sm sm:right-6 sm:bottom-6"
    >
      <span id="deck-progress-current">1</span><span class="mx-1">/</span><span id="deck-progress-total">1</span>
    </div>


    <dialog
      id="deck-help-dialog"
      class="max-w-md rounded-lg border border-zinc-700 bg-zinc-900 p-6 text-zinc-100 backdrop:bg-black/50"
    >
      <h3 class="font-title mb-4 text-xl">Keyboard shortcuts</h3>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
        <dt class="font-mono text-zinc-400">→ / Space / PgDn</dt><dd>Next slide</dd>
        <dt class="font-mono text-zinc-400">← / PgUp</dt><dd>Previous slide</dd>
        <dt class="font-mono text-zinc-400">Home / End</dt><dd>First / last slide</dd>
        <dt class="font-mono text-zinc-400">F</dt><dd>Toggle fullscreen</dd>
        <dt class="font-mono text-zinc-400">N</dt><dd>Toggle speaker notes</dd>
        <dt class="font-mono text-zinc-400">O</dt><dd>Overview (all slides)</dd>
        <dt class="font-mono text-zinc-400">P</dt><dd>Open presenter window</dd>
        <dt class="font-mono text-zinc-400">?</dt><dd>This help</dd>
        <dt class="font-mono text-zinc-400">Esc</dt><dd>Exit fullscreen / overview</dd>
      </dl>
      <form method="dialog" class="mt-6 text-right">
        <button class="rounded bg-zinc-800 px-4 py-1.5 text-sm hover:bg-zinc-700" type="submit">
          Close
        </button>
      </form>
    </dialog>
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  /* Neutralize the site-wide body constraints (max-w-3xl, flex, padding) for deck pages */
  body:has(#deck) {
    max-width: none !important;
    width: 100vw !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
  }

  .slide {
    display: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  .slide.is-active {
    display: flex;
  }

  .slide:focus,
  .slide *:focus {
    outline: none;
  }

  /* Overview mode: scale all slides down into a grid */
  body.deck-overview #deck {
    overflow: auto;
    height: 100svh;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    padding: 1rem;
    background: #000;
  }

  body.deck-overview .slide {
    display: flex;
    position: relative;
    height: 180px;
    overflow: hidden;
    border-radius: 0.5rem;
    outline: 2px solid transparent;
    transform: none;
    cursor: pointer;
    transition: outline-color 0.15s;
  }

  body.deck-overview .slide.is-active {
    outline-color: rgb(34 197 94);
  }

  body.deck-overview .slide > * {
    transform: scale(0.25);
    transform-origin: top left;
    width: 400%;
    height: 400%;
  }

  body.deck-notes [data-slide-notes] {
    display: block;
  }

  body.deck-hud-hidden #deck-hud,
  body.deck-hud-hidden #deck-progress {
    opacity: 0;
  }

  /* Bare-image safety net for slot content (no Tailwind class). Wrapped in
     @layer base so Tailwind v4 utilities like `h-full` (in the `utilities`
     layer, declared after `base`) win by cascade-layer order — needed for
     absolutely-positioned full-bleed images in Slide.astro and the grid
     cells in SlideImageRow.astro. The :where() also keeps the rule's
     specificity at (0,0,0,1) so unlayered classes still override it. */
  @layer base {
    :where(.slide) img {
      max-width: 100%;
      height: auto;
    }
  }

  .slide figure {
    margin: 0;
  }

  /* On portrait or square viewports (mostly phones held vertically),
     render the slide at a fixed 1280×720 desktop canvas and scale it
     down with transform so all proportions (text, padding, image
     positioning) match a desktop view rather than being skewed by
     viewport-based Tailwind breakpoints. Letterbox bars appear in
     the leftover vertical space. Desktop, laptops, ultrawides, and
     rotated-landscape phones are unaffected. Scoped to :not(.deck-overview)
     so the O-key grid view keeps 320×180 thumbnails. */
  @media (max-aspect-ratio: 1/1) {
    body:not(.deck-overview) .slide.is-active {
      position: absolute;
      width: 1280px;
      height: 720px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(calc(100vw / 1280px));
      flex: none;
    }
  }

  #deck-preload.is-done {
    opacity: 0;
    pointer-events: none;
  }

  /* Presenter mode: show timer + next-hint overlay; hide the open-presenter
     button (you're already in presenter); auto-show speaker notes. */
  body.is-presenter #deck-presenter-overlay {
    display: flex;
  }

  body.is-presenter #deck-presenter-btn {
    display: none;
  }
</style>

<script>
  async function prefetchAll() {
    const preloadEl = document.getElementById("deck-preload");
    const preloadTextEl = document.getElementById("deck-preload-text");

    const images = Array.from(
      document.querySelectorAll<HTMLImageElement>("#deck img"),
    );
    const videos = Array.from(
      document.querySelectorAll<HTMLVideoElement>("#deck video"),
    );

    // Browser default is preload="metadata"; force the full download so
    // navigating to a video slide mid-talk doesn't hit a network buffer.
    videos.forEach((v) => {
      v.preload = "auto";
      try {
        v.load();
      } catch {}
    });

    const total = images.length + videos.length;
    let done = 0;

    const padWidth = String(total).length;
    const update = () => {
      if (preloadTextEl) {
        preloadTextEl.textContent =
          total === 0
            ? "Ready"
            : `Preloading ${String(done).padStart(padWidth, "0")} / ${total}`;
      }
    };
    update();

    const decodeImage = async (img: HTMLImageElement) => {
      try {
        if (!img.complete) {
          await new Promise<void>((resolve) => {
            const onSettle = () => {
              img.removeEventListener("load", onSettle);
              img.removeEventListener("error", onSettle);
              resolve();
            };
            img.addEventListener("load", onSettle);
            img.addEventListener("error", onSettle);
          });
        }
        if (typeof img.decode === "function") {
          await img.decode().catch(() => {});
        }
      } catch {}
      done++;
      update();
    };

    const waitForVideo = (v: HTMLVideoElement) =>
      new Promise<void>((resolve) => {
        if (v.readyState >= 4) {
          resolve();
          return;
        }
        const onReady = () => {
          v.removeEventListener("canplaythrough", onReady);
          v.removeEventListener("error", onReady);
          resolve();
        };
        v.addEventListener("canplaythrough", onReady);
        v.addEventListener("error", onReady);
      }).then(() => {
        done++;
        update();
      });

    await Promise.all([
      ...images.map(decodeImage),
      ...videos.map(waitForVideo),
    ]);

    preloadEl?.classList.add("is-done");
    setTimeout(() => preloadEl?.remove(), 600);
  }

  function initDeck() {
    prefetchAll();

    const slides = Array.from(
      document.querySelectorAll<HTMLElement>("#deck [data-slide]"),
    );
    if (slides.length === 0) return;

    const total = slides.length;
    const totalEl = document.getElementById("deck-progress-total");
    const currentEl = document.getElementById("deck-progress-current");
    if (totalEl) totalEl.textContent = String(total);

    const parseHash = (): number => {
      const m = window.location.hash.match(/^#(\d+)$/);
      if (!m) return 0;
      const n = parseInt(m[1], 10) - 1;
      return Math.max(0, Math.min(total - 1, n));
    };

    let index = parseHash();
    let hudTimer: ReturnType<typeof setTimeout> | null = null;

    // Presenter mode is activated by ?presenter=1 on the URL. The presenter
    // window auto-shows speaker notes, runs an elapsed timer, and surfaces a
    // "Next: …" hint. Display + presenter windows of the same deck stay in
    // sync via a BroadcastChannel scoped to this pathname.
    const isPresenter = new URLSearchParams(location.search).has("presenter");
    if (isPresenter) {
      document.body.classList.add("is-presenter");
      document.body.classList.add("deck-notes");
    }

    const channelName = `deck:${location.pathname.replace(/\/$/, "")}`;
    let channel: BroadcastChannel | null = null;
    try {
      channel = new BroadcastChannel(channelName);
    } catch {
      // BroadcastChannel unsupported (very old browser): degrade silently.
      channel = null;
    }

    const broadcastGoto = (slideNumber: number) => {
      channel?.postMessage({ type: "goto", slide: slideNumber });
    };

    const openPresenter = () => {
      const url = new URL(location.href);
      url.searchParams.set("presenter", "1");
      window.open(
        url.toString(),
        "deckPresenter",
        "width=1280,height=800,noopener=no",
      );
    };

    const nextHintEl = document.getElementById("deck-next-hint");
    const updateNextHint = () => {
      if (!nextHintEl) return;
      const upcoming = slides[index + 1];
      if (!upcoming) {
        nextHintEl.textContent = "(end of deck)";
        return;
      }
      const titleEl = upcoming.querySelector("h1, h2");
      const subtitleEl = upcoming.querySelector("p");
      const title = titleEl?.textContent?.trim() ?? "";
      const subtitle = subtitleEl?.textContent?.trim() ?? "";
      nextHintEl.textContent = title
        ? subtitle
          ? `Next: ${title} — ${subtitle}`
          : `Next: ${title}`
        : `Next: Slide ${index + 2}`;
    };

    if (isPresenter) {
      const timerEl = document.getElementById("deck-timer");
      const startedAt = Date.now();
      const formatTime = (totalSeconds: number) => {
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = totalSeconds % 60;
        const pad = (n: number) => String(n).padStart(2, "0");
        return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
      };
      const tickTimer = () => {
        if (!timerEl) return;
        timerEl.textContent = formatTime(
          Math.floor((Date.now() - startedAt) / 1000),
        );
      };
      tickTimer();
      setInterval(tickTimer, 1000);
    }

    const showHud = () => {
      document.body.classList.remove("deck-hud-hidden");
      if (hudTimer) clearTimeout(hudTimer);
      hudTimer = setTimeout(() => {
        document.body.classList.add("deck-hud-hidden");
      }, 3000);
    };

    // Force the browser to (re-)decode the slide's images and seek videos to
    // their first frame. Browsers free decoded bitmaps for `display: none`
    // subtrees under memory pressure, so even after `prefetchAll()` ran on
    // init, navigating to a long-untouched slide can show a flash before the
    // bitmap is repainted. Calling decode() here is ~5ms when the bitmap is
    // still resident and forces a re-decode otherwise.
    const ensureSlideReady = async (slide: HTMLElement | undefined) => {
      if (!slide) return;
      const imgs = Array.from(
        slide.querySelectorAll<HTMLImageElement>("img"),
      );
      await Promise.all(
        imgs.map((img) =>
          typeof img.decode === "function"
            ? img.decode().catch(() => {})
            : Promise.resolve(),
        ),
      );
    };

    let renderToken = 0;

    const render = async (
      next: number,
      pushHash = true,
      broadcast = true,
    ) => {
      const myToken = ++renderToken;
      const targetIndex = Math.max(0, Math.min(total - 1, next));

      await ensureSlideReady(slides[targetIndex]);
      // Stale render: a newer navigation has superseded this one.
      if (myToken !== renderToken) return;

      index = targetIndex;
      slides.forEach((s, i) => {
        s.classList.toggle("is-active", i === index);
      });
      if (currentEl) currentEl.textContent = String(index + 1);
      if (pushHash) {
        const newHash = `#${index + 1}`;
        if (window.location.hash !== newHash) {
          history.replaceState(null, "", newHash);
        }
      }

      updateNextHint();
      if (broadcast) broadcastGoto(index + 1);

      // Warm adjacent slides so the next nav is instant.
      void ensureSlideReady(slides[index - 1]);
      void ensureSlideReady(slides[index + 1]);
    };

    if (channel) {
      channel.addEventListener("message", (e) => {
        const data = e.data as
          | { type: "goto"; slide: number }
          | { type: "state"; slide: number }
          | { type: "request-state" }
          | undefined;
        if (!data || typeof data !== "object") return;
        if (
          (data.type === "goto" || data.type === "state") &&
          typeof data.slide === "number" &&
          data.slide - 1 !== index
        ) {
          // Apply remote nav locally without re-broadcasting.
          render(data.slide - 1, false, false);
        } else if (data.type === "request-state") {
          channel?.postMessage({ type: "state", slide: index + 1 });
        }
      });
      // Late-joiner: ask any existing window for the current slide.
      setTimeout(() => channel?.postMessage({ type: "request-state" }), 50);
    }

    const next = () => render(index + 1);
    const prev = () => render(index - 1);

    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      if (
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.isContentEditable)
      ) {
        return;
      }
      switch (e.key) {
        case "ArrowRight":
        case "PageDown":
        case " ":
          e.preventDefault();
          next();
          break;
        case "ArrowLeft":
        case "PageUp":
          e.preventDefault();
          prev();
          break;
        case "Home":
          e.preventDefault();
          render(0);
          break;
        case "End":
          e.preventDefault();
          render(total - 1);
          break;
        case "f":
        case "F":
          e.preventDefault();
          toggleFullscreen();
          break;
        case "n":
        case "N":
          e.preventDefault();
          document.body.classList.toggle("deck-notes");
          break;
        case "o":
        case "O":
          e.preventDefault();
          toggleOverview();
          break;
        case "p":
        case "P":
          e.preventDefault();
          openPresenter();
          break;
        case "?":
          e.preventDefault();
          (document.getElementById("deck-help-dialog") as HTMLDialogElement | null)?.showModal();
          break;
        case "Escape":
          if (document.body.classList.contains("deck-overview")) {
            document.body.classList.remove("deck-overview");
          }
          break;
      }
    });

    // Mouse movement reveals HUD
    document.addEventListener("mousemove", showHud);

    // Fullscreen button
    const fsBtn = document.getElementById("deck-fullscreen");
    fsBtn?.addEventListener("click", toggleFullscreen);
    const helpBtn = document.getElementById("deck-help");
    helpBtn?.addEventListener("click", () => {
      (document.getElementById("deck-help-dialog") as HTMLDialogElement | null)?.showModal();
    });
    const presenterBtn = document.getElementById("deck-presenter-btn");
    presenterBtn?.addEventListener("click", openPresenter);

    // Touch swipe
    let touchX = 0;
    let touchY = 0;
    document.addEventListener("touchstart", (e) => {
      const t = e.touches[0];
      touchX = t.clientX;
      touchY = t.clientY;
      showHud();
    });
    document.addEventListener("touchend", (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - touchX;
      const dy = t.clientY - touchY;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) next();
        else prev();
      }
    });

    // Click to navigate: left 25% = prev, rest = next. HUD/dialog/links skip.
    document.getElementById("deck")?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        target.closest("#deck-hud") ||
        target.closest("#deck-help-dialog") ||
        target.closest("a, button")
      ) {
        return;
      }
      if (document.body.classList.contains("deck-overview")) {
        const slideEl = target.closest("[data-slide]") as HTMLElement | null;
        if (!slideEl) return;
        const i = slides.indexOf(slideEl);
        if (i >= 0) {
          document.body.classList.remove("deck-overview");
          render(i);
        }
        return;
      }
      if (e.clientX < window.innerWidth * 0.25) {
        prev();
      } else {
        next();
      }
    });

    // Prevent native drag/selection on slide media so click never feels "stuck"
    document.getElementById("deck")?.addEventListener("mousedown", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("#deck-hud") || target.closest("a, button")) return;
      e.preventDefault();
    });

    window.addEventListener("hashchange", () => {
      render(parseHash(), false);
    });

    render(index, false);
    // Flash the HUD once on load so first-time visitors discover the controls.
    showHud();
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  function toggleOverview() {
    document.body.classList.toggle("deck-overview");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDeck);
  } else {
    initDeck();
  }
</script>
